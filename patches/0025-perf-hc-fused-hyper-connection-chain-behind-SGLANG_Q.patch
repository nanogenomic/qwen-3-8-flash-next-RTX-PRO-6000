+        return mixed_input, (hyper_input, hyper_input_normed)
+
+    def _qwenopt_combine(self, block_output, residuals):
+        """Returns ``(block_output, residuals, fused_or_None)``; on None the caller runs
+        the original combine on the returned (materialised, 2-tuple) operands."""
+        from sglang.kernels.ops.elementwise.hc_fused_tail import (
+            DeferredSharedAdd,
+            hc_fused_tail,
+            hc_fused_tail_supported,
+        )
+
+        deferred = isinstance(block_output, DeferredSharedAdd)
+        if len(residuals) == 3:
+            hyper_input, hyper_input_normed, gate_logits = residuals
+            y_dtype = (block_output.routed if deferred else block_output).dtype
+            y_cuda = (block_output.routed if deferred else block_output).is_cuda
+            if (
+                hyper_input.shape[0] > 0
+                and y_cuda
+                and hyper_input.dtype == y_dtype
+                and hc_fused_tail_supported(
+                    self.hc_count, self.hidden_size, hyper_input.dtype
+                )
+                and hyper_input.is_contiguous()
+            ):
+                nxt = self._qwenopt_next
+                norm_w, eps = None, 0.0
+                if (
+                    nxt is not None
+                    and nxt.hc_count == self.hc_count
+                    and nxt.config.hc_per_branch_norm
+                    and nxt.hc_norm._jit_group_size == self.hidden_size
+                    and nxt.hc_norm.weight.dtype == hyper_input.dtype
+                ):
+                    norm_w = nxt.hc_norm.weight
+                    eps = nxt.hc_norm.variance_epsilon
+                hyper, normed = hc_fused_tail(
+                    block_output,
+                    hyper_input,
+                    gate_logits,
+                    self.hc_count,
+                    self.hidden_size,
+                    norm_weight=norm_w,
+                    eps=eps,
+                )
+                if normed is not None:
+                    nxt._qwenopt_prenormed = (hyper, normed)
+                return block_output, residuals, hyper
+            residuals = (hyper_input, hyper_input_normed)
+        if deferred:
+            block_output = block_output.materialize()
+        return block_output, residuals, None
+
+    def qwenopt_set_next(self, nxt: Optional["GatedResidual"]) -> None:
+        # object.__setattr__: keep the neighbour out of this module's submodule tree.
+        object.__setattr__(self, "_qwenopt_next", nxt)
+
+
