+                    else {}
+                ),
             )
             dynk_done = True
         else:
@@ -2701,7 +2705,11 @@ def select_experts(
                 )
             # ===== END TO BE REFACTORED ====
             if _dynk_params is not None and packed_topk is None:
+                # num_token_non_padded lets the kernel exclude padded graph rows from
+                # its kept-slot counters; the padded-row mask it applies (-1, 0.0) is
