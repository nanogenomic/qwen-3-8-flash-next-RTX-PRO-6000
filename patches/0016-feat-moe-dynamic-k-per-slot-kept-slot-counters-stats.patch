                 _fused_topk_kwargs["dynk"] = _dynk_params
+                _fused_topk_kwargs["num_token_non_padded"] = num_token_non_padded
                 _dynk_done = True
             topk_weights, topk_ids = fused_topk(
                 hidden_states=hidden_states,
