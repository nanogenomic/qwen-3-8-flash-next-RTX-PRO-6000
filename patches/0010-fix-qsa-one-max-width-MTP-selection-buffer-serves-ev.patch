+    def qsa_mtp_index_share_tail_width(self) -> int:
+        """Tail columns the shared selection must carry.
+
+        The tail is the only cover for positions drafted since the capture, so it
+        has to reach the whole verify window. Chain speculation gives
+        ``W == num_steps + 1``; a config that widens the window without widening
+        the chain would silently drop the newest positions from every MTP decode
+        step's selection, which reads as a quiet acceptance loss.
+
+        Under adaptive speculation the active window changes after this runs, so
+        the width is the DEEPEST reachable tier's. A tail wider than the active
+        window is harmless -- ``QSAMTPSharedSparseIndices.lookup`` marks every
+        tail slot past the current position -1 and downstream drops those -- so
+        one max-width buffer serves every state, and keeping a single buffer
+        (rather than one per state) is what makes capture and lookup agree
+        across a state swap.
+        """
+        widths = [
+            get_spec().speculative_num_steps + 1,
+            self.speculative_num_draft_tokens or 0,
+            max_speculative_num_draft_tokens() or 0,
+        ]
+        return max(widths)
+
