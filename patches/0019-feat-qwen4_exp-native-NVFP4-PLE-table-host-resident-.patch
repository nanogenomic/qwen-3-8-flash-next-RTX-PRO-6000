+            ple_mod = ple_modules.get(mod_prefix)
+            emb = getattr(ple_mod, "ngram_embedding", None)
+            is_nvfp4_tensor = match.group(2) == "weight_scale" or (
+                loaded_weight.dtype == torch.uint8
