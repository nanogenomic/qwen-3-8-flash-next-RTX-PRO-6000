+    def _reserve_shared_packed_kv(self, max_bs: int, max_num_tokens: int) -> None:
+        """Claim packed-KV scratch at the DEEPEST reachable verify window.
+
+        Called before this backend's graphs are captured. ``max_num_tokens`` is
+        the ACTIVE tier's window under adaptive speculation, so the reservation
+        scales it up to the widest reachable one: the shared buffer must be
+        allocated at its final size before the first capture bakes in its
+        address."""
+        if not self._share_scratch:
+            return
+        from sglang.srt.runtime_context import max_speculative_num_draft_tokens
+
+        try:
