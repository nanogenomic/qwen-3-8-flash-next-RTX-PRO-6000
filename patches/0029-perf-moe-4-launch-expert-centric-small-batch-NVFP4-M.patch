+def _sbmoe_eligible(x, x_sf, output, output_dtype, topk_ids, quant_info, runner_config, enable_alltoall):
+    if quant_info.quant_type != "fp4" or x_sf is not None or enable_alltoall:
+        return False
+    if x.dim() != 2 or x.dtype != torch.bfloat16 or output_dtype != torch.bfloat16:
+        return False
+    T, H = x.shape
+    if not (1 <= T <= _QWENOPT_FUSE_SBMOE_MAX_T) or topk_ids.dim() != 2 or topk_ids.shape[1] > 16:
+        return False
+    if tuple(output.shape) != (T, H) or not output.is_contiguous() or not x.is_contiguous():
+        return False
+    if quant_info.moe_ep_size != 1 or quant_info.moe_tp_size != 1:
+        return False
+    if any(v is not None for v in (quant_info.swiglu_alpha, quant_info.swiglu_beta, quant_info.swiglu_limit)):
+        return False
+    if getattr(runner_config, "apply_router_weight_on_input", False) or not runner_config.is_gated:
+        return False
