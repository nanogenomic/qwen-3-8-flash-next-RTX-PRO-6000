+# (sglang/kernels/ops/moe/qwenopt_small_batch_nvfp4_moe.py) instead of flashinfer's 9-launch CUTLASS
+# pipeline. Measured bitwise-equal to cutlass_fused_moe on real weights/routing. Unset -> unchanged.
+_QWENOPT_FUSE_SBMOE = os.environ.get("SGLANG_QWENOPT_FUSE_SBMOE", "0") == "1"
+_QWENOPT_FUSE_SBMOE_MAX_T = int(os.environ.get("SGLANG_QWENOPT_FUSE_SBMOE_MAX_T", "16"))
+
