+    if _activation_type(runner_config) != activation_types.Swiglu:
+        return False
+    w13, w2 = quant_info.w13_weight, quant_info.w2_weight
+    if w13.dtype != torch.uint8 or w2.dtype != torch.uint8 or w13.dim() != 3 or w2.dim() != 3:
+        return False
+    E, N2, Kh = w13.shape
+    I = N2 // 2
+    if Kh * 2 != H or tuple(w2.shape) != (E, H, I // 2):
+        return False
+    if H % 256 or I % 128 or N2 % 128 or (I // 16) % 4:
+        return False
+    qs = quant_info.quant_scales
+    if qs is None or len(qs) != 6:
+        return False
+    if qs[1].numel() * qs[1].element_size() != E * N2 * (H // 16):
+        return False
+    if qs[4].numel() * qs[4].element_size() != E * H * (I // 16):
+        return False
+    return True
