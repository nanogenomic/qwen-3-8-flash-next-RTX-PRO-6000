+    def _record_tier_stats(
+        self,
+        slot: AdaptiveStepSlot,
+        num_correct_drafts_per_req: list[int],
+        batch_size: int,
+    ) -> None:
+        """Attribute this verify's acceptance to the width that produced it."""
+        if not num_correct_drafts_per_req:
+            return
+        bs_key = self._find_closest_bs(self._pad_to_cuda_graph_bs(batch_size))
+        key = (bs_key, slot.current_steps)
+        entry = self._tier_stats.get(key)
+        if entry is None:
+            entry = {"verifies": 0.0, "reqs": 0.0, "correct": 0.0, "batch_sum": 0.0}
+            self._tier_stats[key] = entry
+        entry["verifies"] += 1.0
+        entry["reqs"] += float(len(num_correct_drafts_per_req))
+        entry["correct"] += float(sum(num_correct_drafts_per_req))
+        entry["batch_sum"] += float(batch_size)
+        self._tier_stats_verifies += 1
+        if (
+            self._tier_stats_log_interval > 0
+            and self._tier_stats_verifies % self._tier_stats_log_interval == 0
+        ):
+            log_info_on_rank0(logger, "Adaptive spec tiers: " + self.tier_stats_line())
+
+    def tier_stats(self) -> dict[str, dict[str, float]]:
+        """Per-(bs slot, steps) acceptance, keyed ``"bs<N>/steps<M>"``.
+
+        ``accept_len`` is tokens committed per verify (accepted drafts + the
+        always-committed bonus token), i.e. the same quantity as the scheduler's
+        ``accept len``, restricted to one tier. ``accept_rate`` divides by that
+        tier's own draft width, which the aggregate metric cannot do.
+        """
+        out: dict[str, dict[str, float]] = {}
+        for (bs_key, steps), entry in sorted(self._tier_stats.items()):
+            reqs = entry["reqs"]
+            if reqs <= 0:
+                continue
+            drafts = reqs * steps
+            out[f"bs{bs_key}/steps{steps}"] = {
+                "verifies": entry["verifies"],
+                "reqs": reqs,
+                "accept_len": entry["correct"] / reqs + 1.0,
+                "accept_rate": (entry["correct"] / drafts) if drafts > 0 else 0.0,
+                "mean_batch": entry["batch_sum"] / entry["verifies"],
+            }
+        return out
+
+    def tier_stats_line(self) -> str:
+        return " | ".join(
+            f"{name} n={int(v['verifies'])} accept_len={v['accept_len']:.3f} "
+            f"accept_rate={v['accept_rate']:.3f} mean_bs={v['mean_batch']:.1f}"
+            for name, v in self.tier_stats().items()
+        )
+
