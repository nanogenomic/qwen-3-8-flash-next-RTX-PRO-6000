         output = sparse_gqa_fwd_interface_triton_ck(
             q.contiguous(),
-            k_parts[0] if len(k_parts) == 1 else torch.cat(k_parts),
-            v_parts[0] if len(v_parts) == 1 else torch.cat(v_parts),
-            topk_indices,
+            k_buffer,
+            v_buffer,
+            pool_slots,
             cu_seqlens_q,
-            cu_seqlens_k,
+            torch.zeros_like(cu_seqlens_q),
             sequence_lens_tensor,
