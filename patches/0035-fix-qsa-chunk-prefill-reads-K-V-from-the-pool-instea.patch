     return out
 
 
+@triton.jit
+def _logical_to_pool_slots(
+    indices,
+    out,
+    req_to_token,
+    req_indices,
+    cu_q,
+    kv_lens,
+    topk,
+    si_m,
+    so_m,
+    req_stride,
+    BLOCK_T: tl.constexpr,
+):
+    query_relative = tl.program_id(0)
+    batch = tl.program_id(1)
+    q_start = tl.load(cu_q + batch)
+    q_end = tl.load(cu_q + batch + 1)
+    query = (q_start + query_relative).to(tl.int64)
+    if query >= q_end:
+        return
+    req = tl.load(req_indices + batch).to(tl.int64)
+    length = tl.load(kv_lens + batch)
+    cols = tl.program_id(2) * BLOCK_T + tl.arange(0, BLOCK_T)
+    in_row = cols < topk
+    positions = tl.load(indices + query * si_m + cols, mask=in_row, other=-1)
+    valid = (positions >= 0) & (positions < length)
+    slots = tl.load(
+        req_to_token + req * req_stride + tl.where(valid, positions, 0),
+        mask=valid,
+        other=0,
+    )
+    slots = tl.where(valid, slots, -1)
+    tl.store(out + query * so_m + cols, slots.to(out.dtype.element_ty), mask=in_row)
+
+
+def qsa_logical_to_pool_slots_triton(
+    indices, req_to_token, req_indices, cu_q, kv_lens, max_q, wide=False
+):
+    """Map chunk-prefill top-k LOGICAL positions to KV-pool slots.
+
+    ``indices`` is ``[total_q, topk]``: row ``r`` of request ``b`` holds positions in
+    ``[0, kv_lens[b])`` (``-1`` = unused). The result has the same shape and holds
+    ``req_to_token[req_indices[b], pos]`` for every valid position and ``-1`` for the
+    rest, so ``sparse_gqa_fwd_interface_triton_ck`` can read K/V straight out of the
+    pool (``cu_k`` all zero) instead of from a gathered copy of the whole context.
+    ``wide`` emits int64 slots: the kernel computes ``slot * k.stride(0)`` in the
+    index dtype, which overflows int32 once the pool passes ``2**31 / stride`` rows.
+    """
+    total_q, topk = indices.shape
+    out = torch.empty(
+        (total_q, topk),
+        dtype=torch.int64 if wide else torch.int32,
+        device=indices.device,
+    )
+    block_t = min(1024, triton.next_power_of_2(topk))
+    batch = cu_q.shape[0] - 1
+    if total_q == 0 or batch == 0:
+        return out
+    _logical_to_pool_slots[(max_q, batch, triton.cdiv(topk, block_t))](
+        indices,
+        out,
+        req_to_token,
+        req_indices,
+        cu_q,
+        kv_lens,
+        topk,
+        indices.stride(0),
+        out.stride(0),
+        req_to_token.stride(0),
+        BLOCK_T=block_t,
+        num_warps=4,
+    )
+    return out
+
+
 def sparse_gqa_packed_decode_triton(q, k, v, indices, cu_q, cu_k, kv_lens, scale):
     """Run one packed sparse-attention row per request without a host sync.
 
