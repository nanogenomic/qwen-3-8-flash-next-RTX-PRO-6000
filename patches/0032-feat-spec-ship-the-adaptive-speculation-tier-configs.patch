+  "1": {
+    "candidate_steps": [3, 5, 7],
+    "up_hysteresis": -1.21,
+    "down_hysteresis": -1.46,
+    "ema_alpha": 0.15,
+    "update_interval": 8,
+    "warmup_batches": 10,
+    "ceiling_coeff": 0
+  },
+  "2": {
+    "candidate_steps": [3, 5],
+    "up_hysteresis": -1.0,
+    "down_hysteresis": -1.25,
+    "ema_alpha": 0.15,
+    "update_interval": 8,
+    "warmup_batches": 10,
+    "ceiling_coeff": 0
+  },
+  "4": {
+    "candidate_steps": [3],
+    "_why": "FIXED at the static width. bs 4..7 route here, so listing a second candidate would make the steps=1 state capture 5 batch sizes instead of 1 (+0.3-0.4 GB of graph VRAM against 2.82 GB spare [measured, config B boot log]), and the hard constraint at conc 4 is >= config B, which IS static n=3 -- pinning reproduces it by construction."
+  },
+  "8": {
+    "candidate_steps": [1, 3],
+    "up_hysteresis": 0.0,
+    "down_hysteresis": 0.0,
+    "ema_alpha": 0.2,
+    "update_interval": 5,
+    "warmup_batches": 10,
+    "ceiling_coeff": 0
+  }
