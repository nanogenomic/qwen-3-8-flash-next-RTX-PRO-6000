+# =========================================================================
+# SHARE-BOUNDED CEILINGS — the grants themselves must not oversubscribe
+# [bd-dre-x3n0x]
+# =========================================================================
+# ⛔ 2026-09-30, live production stall. /v1/loads: num_used_tokens 421,888 of a
+# 451,264 pool (0.9349), 1 running, 10 waiting, num_waiting_uncached_tokens
+# 479,548 — MORE THAN THE WHOLE POOL — cache_hit_rate 0.0, gen_throughput 0.0.
+# One architect main had grown to a 522,880 window holding a 433,782-token
+# prompt: 96% of the pool in one session, prefix cache fully evicted, nothing
+# generating.
+#
+# THE BUG WAS IN THE GRANT, NOT THE MEASUREMENT. The published allowance read:
+#   pid 900001  main_window 451,264  main_grow_max 451,264  child_grow_max 451,264
+#   pid 900002  main_window 451,264  main_grow_max 451,264  child_grow_max 451,264
+#   invariant {ok: True, total: 406,137, limit: 406,138}
+# Each of two sessions was granted the ENTIRE pool as its window AND its growth
+# ceiling — 2 x 451,264 against a 451,264-token pool — and the invariant said
+# "ok" because it summed MEASURED CURRENT RESERVATIONS, not the ceilings it was
+# handing out. It was blind to the exact failure it existed to prevent.
+#
+# Two mechanisms produced it, and both are fixed:
+#   1. RulePolicy returned main_grow_max = pool.ceiling and child_grow_max =
+#      pool.ceiling — the whole pool, per session, unconditionally.
+#   2. apply_rails' old "mains are never shrunk" rail did mg = max(a.main_grow_max,
+#      main_window), which RAISED any bounded grow ceiling back up to the
+#      session's already-grown window. No policy could express "you are above
+#      your share, do not grow" even if it wanted to.
+#
+# ⛔ WHY claim_growth WAS NOT ENOUGH. Growth already debits an atomic claim
+# against live free pool, so two sessions cannot grow into the same tokens at the
+# same time. What it cannot stop is SEQUENTIAL RATCHETING: session A grows 8K
+# whenever the pool happens to be free, over and over, and with a ceiling of
+# "the whole pool" there is nothing to stop the cumulative result being the whole
+# pool. claim_growth bounds each STEP; the ceiling bounds the OUTCOME. Both are
+# needed, and claim_growth stays exactly as it is.
+#
+# ⛔ SHAPE OF THE FIX (Andre 2026-09-30: keep mains generous; GPU1 stays free for
+# training, so a second replica is not the answer). Ceilings are a SHARE of the
+# live pool, derived — never a constant and never the whole pool:
+#   * one floor-sized child is reserved first, so a main can always delegate;
+#   * what is left is split among the live mains by WATER-FILLING: each main first
+#     takes the SMALLER of an equal share and what it can actually use (never less
+#     than GUARANTEED_LANE_WINDOW — Andre: a primary lane below ~80K is useless),
+#     and whatever is then still unclaimed goes to the mains that want more, in
+#     proportion to how much more. A lender's ceiling therefore drops BELOW the
+#     equal share, which is what makes the sum add up; it is revocable at the next
+#     5 s refresh, and revoking it does not shrink the borrower — the borrower just
+#     stops being granted growth. So a busy main beside an idle one gets ~270,336,
+#     two busy mains get ~196,608 each, and one alone gets 401,408 — Andre's own
+#     statement of the real trade: "two mains at ~200K each, or one at 400K".
+#   ⛔ The obvious version of this is WRONG and was caught in test: if every main
+#     keeps a guaranteed equal share AND the under-users also lend their unused
+#     part away, the same tokens are promised twice (measured: 350,617 granted
+#     against a 348,052 budget). A lender must actually give up the share.
+#   * the child ceiling is what remains after every main's granted ceiling is
+#     paid for, divided by the shared child-stream budget.
+# Every number comes from the LIVE max_total_num_tokens, so if host-KV offload
+# raises the pool to ~1M the ceilings widen automatically with no edit here.
+#
+# When two mains genuinely cannot both be large, the honest outcome is that the
+# second one's growth claim is REFUSED and it compacts — recoverable — instead of
+# both being admitted and the pool deadlocking at gen_throughput 0.0.
+def derive_window_ceilings(usable_tokens: int, mains: List[dict], child_streams: int,
+                           child_max_tokens: int, threshold_percent: float,
+                           ceiling: int) -> tuple:
+    """Share-bounded (window, grow) ceilings whose WORST CASE fits usable_tokens.
+
+    Returns (per_pid_main_ceiling, child_ceiling, detail). `mains` rows need
+    "pid", "max_tokens" and "need" (the UNSCALED measured demand — what the
+    session can actually use; the scaled "reserved" is an artifact of over-demand
+    and would make the split depend on the scaling). Pure arithmetic — no I/O, no
+    globals beyond the geometry constants — so the regression test can drive it
+    directly, which is how the double-counting bug above was caught."""
+    # ⛔ Reserve EVERY child stream that is being granted, not one. Reserving a
+    # single floor child while the broker handed out three was a second way to
+    # over-grant: child_budget // streams fell below one floor child, and
+    # largest_window_within then returns its FLOOR, so each of three streams cost
+    # 58,086 against a 63,713 budget (measured: 516,683 granted vs 406,138 usable).
+    # max(1, ...) keeps the old guarantee that one floor child always fits even
+    # when the stream budget is momentarily 0 (VRAM critical, or a full pool).
+    reserve_child = inflight(CHILD_FLOOR, child_max_tokens, threshold_percent)
+    # ⛔ MAINS OUTRANK CHILD STREAMS. If the pool cannot afford both N main lanes
+    # and the requested streams, give up STREAMS first — a main is Andre's primary
+    # lane and a subagent is discretionary. Walk the stream count down until the
+    # whole grant fits; the caller adopts detail["child_streams"], so what is
+    # reserved is exactly what is handed out.
+    last = None
+    for streams in range(max(1, int(child_streams or 0)), 0, -1):
+        last = _derive_for_streams(usable_tokens, mains, streams, child_max_tokens,
+                                   threshold_percent, ceiling, reserve_child)
+        if last[2]["feasible"]:
+            return last
+    return last
+
+
+def _derive_for_streams(usable_tokens: int, mains: List[dict], streams: int,
+                        child_max_tokens: int, threshold_percent: float,
+                        ceiling: int, reserve_child: int) -> tuple:
+    """One candidate split at a fixed child-stream count. See derive_window_ceilings."""
+    budget = max(0, int(usable_tokens) - streams * reserve_child)
+    n = len(mains)
+    if n == 0:
+        # No mains discovered. ⛔ The published top-level main_grow_max is the
+        # FALLBACK an UNDISCOVERED main uses (context_compressor reads
+        # sessions[pid] first, then the top level), so it must not be the whole
+        # pool just because the process scan came back empty — that is the same
+        # hole by another route. It is the lane guarantee: enough to work in,
+        # small enough that several undiscovered mains still fit.
+        lone = largest_window_within(budget, MAIN_MAX_TOKENS_DEFAULT, ceiling,
+                                     floor=MAIN_WINDOW_FLOOR,
+                                     threshold_percent=threshold_percent)
+        fallback = min(GUARANTEED_LANE_WINDOW, ceiling, lone)
+        left = max(0, int(usable_tokens) - inflight(fallback, MAIN_MAX_TOKENS_DEFAULT,
+                                                   threshold_percent))
+        child = largest_window_within(left // streams,
+                                      child_max_tokens, ceiling,
+                                      floor=CHILD_FLOOR,
+                                      threshold_percent=threshold_percent)
+        cost = inflight(fallback, MAIN_MAX_TOKENS_DEFAULT, threshold_percent) \
+            + streams * inflight(child, child_max_tokens, threshold_percent)
+        return {}, child, {"equal_share": budget, "reserve_child": reserve_child,
+                           "child_streams": streams,
+                           "main_budget": budget, "lone_main_window": lone,
+                           "granted_cost": cost,
+                           "feasible": cost <= int(usable_tokens),
+                           "undiscovered_main_fallback": fallback}
+
+    equal = budget // n
+    mt_of = {int(r["pid"]): int(r.get("max_tokens") or MAIN_MAX_TOKENS_DEFAULT)
+             for r in mains}
+    want = {int(r["pid"]): max(0, int(r.get("need") or 0)) for r in mains}
+    # Round 1: the smaller of an equal share and what the session can use, but
+    # never below one guaranteed primary lane. Every first-round take is <= equal,
+    # so the round-1 total can never exceed the budget.
+    first: Dict[int, int] = {}
+    for p, w in want.items():
+        lane = inflight(min(GUARANTEED_LANE_WINDOW, ceiling), mt_of[p], threshold_percent)
+        first[p] = min(equal, max(w, lane))
+    unclaimed = max(0, budget - sum(first.values()))
+    # Round 2: whatever the lenders gave up goes to the mains that want more — and
+    # if nobody is asking for more right now, it is split evenly rather than left
+    # on the table. ⛔ Leaving it unspent caps a ceiling at CURRENT need, which
+    # would disable grow-instead-of-compact entirely (measured: a lone main with a
+    # 60K prompt was granted 131,072 instead of 401,408). A ceiling is headroom for
+    # the growth that has not happened yet, not a record of what is held.
+    extra_want = {p: max(0, want[p] - first[p]) for p in first}
+    total_extra = sum(extra_want.values())
+    even = unclaimed // n
+    out: Dict[int, int] = {}
+    for p, f in first.items():
+        share = f + ((unclaimed * extra_want[p]) // total_extra if total_extra else even)
+        out[p] = largest_window_within(share, mt_of[p], ceiling,
+                                       floor=MAIN_WINDOW_FLOOR,
+                                       threshold_percent=threshold_percent)
+    main_grant = sum(inflight(w, mt_of[p], threshold_percent) for p, w in out.items())
+    child_budget = max(0, int(usable_tokens) - main_grant)
+    child = largest_window_within(child_budget // streams,
+                                  child_max_tokens, ceiling, floor=CHILD_FLOOR,
+                                  threshold_percent=threshold_percent)
+    # ⛔ largest_window_within RETURNS ITS FLOOR when nothing fits, so a budget
+    # below one floor lane does not produce a smaller lane — it produces a lane
+    # that does not fit. That is reported, never hidden: an infeasible split means
+    # this pool cannot host N mains at a usable window plus `streams` children,
+    # and the broker publishes invariant ok=False rather than pretending.
+    cost = main_grant + streams * inflight(child, child_max_tokens, threshold_percent)
+    return out, child, {"equal_share": equal, "reserve_child": reserve_child,
+                        "child_streams": streams,
+                        "main_budget": budget, "lent_by_under_users": unclaimed,
+                        "mains_granted_cost": main_grant,
+                        "child_budget": child_budget,
+                        "granted_cost": cost,
+                        "feasible": cost <= int(usable_tokens)}
+
+
