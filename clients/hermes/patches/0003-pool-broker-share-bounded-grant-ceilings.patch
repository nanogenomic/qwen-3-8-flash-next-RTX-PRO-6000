+                f"{int(allowance.get('pool') or 0):,}", f"{int(tokens or 0):,}",
+                f"{self.threshold_tokens:,}",
+            )
+            return granted
+        except Exception:
+            logger.debug("pool share adoption skipped", exc_info=True)
+            return cur
