+++ b/hermes_cli/cli_commands_mixin.py
@@ -2726,6 +2726,11 @@ class CLICommandsMixin:
         Never raises: a failure here degrades to the old "type continue"
         behavior rather than breaking the command.
         """
+        # ⛔ Clear the wedged-provider streak, for the same reason
+        # GoalManager.resume() clears the judge-health counters [bd-dre-6rpvx]:
