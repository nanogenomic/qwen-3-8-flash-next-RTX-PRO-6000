From 788047d0e234942fefe6dbccbf194e5cb6af3e2c Mon Sep 17 00:00:00 2001
From: Andre Watson <dre@ligandal.com>
Date: Tue, 29 Sep 2026 13:14:00 -0400
Subject: [PATCH] status bar: separate this session's own subagents from
 shared-backend occupancy
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The delegation segment of the status bar rendered `delegation_streams` /
`delegation_slots` as `⇉ 3/4 streams`. Both numbers are read from the model
backend, which counts every client's in-flight requests. When several agent
sessions share one self-hosted backend, a session that has spawned nothing at
all still displays `⇉ 3/4 streams` -- and that reads as "I have 3 subagents and
I am 75% full" when it actually means "the box has 3 busy slots, possibly none
of them mine".

The fix is to count this session's own live children separately and label both
figures, so the bar answers the two different questions it was being asked:

    ⇉ 0 mine · 3/4 backend · 1 free

`0 mine` is the number the operator controls. `3/4 backend` is shared with every
other session on the machine. `1 free` is the only honest answer to "can I spawn
another one right now".

The own count comes from tools.async_delegation.active_task_count(), which is
per-process and expands a fan-out batch to its real child count.

NOTE FOR ANYONE MAKING THIS CHANGE THEMSELVES: the obvious source for "my
children" is the agent's `_active_children`, and it is the wrong one. That is
the synchronous/in-flight list only and reads 0 for async delegations, so the
bar cheerfully shows `0 mine` next to a busy backend -- which is the same class
of wrong answer the change set out to fix, just inverted. This shipped that way
first. active_task_count() is the counter that is actually truthful.

Slot arithmetic is clamped at zero: the backend figure and the slot ceiling come
from different reads and a transient overshoot must not render as a negative
number of free slots.
---
 cli.py | 39 +++++++++++++++++++++++++++++++++++++--
 1 file changed, 37 insertions(+), 2 deletions(-)

diff --git a/cli.py b/cli.py
index 109eb8a..11f29c9 100644
--- a/cli.py
+++ b/cli.py
@@ -6519,6 +6519,30 @@ class HermesCLI(CLIAgentSetupMixin, CLICommandsMixin, CLIBillingMixin):
         snapshot["delegation_percent"] = None
         snapshot["delegation_streams"] = None
         snapshot["delegation_slots"] = None
+        # ⛔ OWN CHILDREN vs BACKEND OCCUPANCY. delegation_streams below is
+        # read from the SHARED backend and counts every client's in-flight
+        # requests -- other Hermes sessions included. A brand-new session with
+        # no children therefore rendered "3/4 streams", which reads as "I have
+        # 3 subagents" when it means "the box has 3 busy slots". Count this
+        # session's own live children separately so the bar can say which is
+        # which, and how many slots are actually left to spawn into.
+        # active_task_count() is the module's own "how many subagents are
+        # actually working right now" figure: it expands a fan-out batch to its
+        # child count and is per-process, so it is genuinely THIS session's.
+        # _active_children is only the synchronous/in-flight list and reads 0
+        # for async delegations, which is how this first shipped showing
+        # "0 mine" next to a busy backend.
+        _own = None
+        try:
+            from tools.async_delegation import active_task_count as _own_task_count
+
+            _own = int(_own_task_count())
+        except Exception:
+            _own = None
+        if _own is None:
+            _sync = getattr(agent, "_active_children", None)
+            _own = len(_sync) if _sync is not None else None
+        snapshot["delegation_own_children"] = _own
         snapshot["delegation_queued"] = None
         snapshot["delegation_replicas"] = None
         snapshot["delegation_same_as_main"] = False
@@ -7552,10 +7576,21 @@ class HermesCLI(CLIAgentSetupMixin, CLICommandsMixin, CLIBillingMixin):
             # bigger engine behind it, which is the single number you need to
             # answer "am I actually getting parallelism or am I queueing?".
             slots = snapshot.get("delegation_slots")
+            own = snapshot.get("delegation_own_children")
+            # "N mine" first because that is the number the operator controls;
+            # the backend figure is shared with every other session on the box.
+            parts = []
+            if own is not None:
+                parts.append(f"{int(own)} mine")
             if slots:
-                body = f"⇉ {stream_count}/{int(slots)} streams"
+                parts.append(f"{stream_count}/{int(slots)} backend")
+                parts.append(f"{max(0, int(slots) - stream_count)} free")
             else:
-                body = f"⇉ {stream_count} stream" + ("" if stream_count == 1 else "s")
+                parts.append(
+                    f"{stream_count} backend stream"
+                    + ("" if stream_count == 1 else "s")
+                )
+            body = "⇉ " + " · ".join(parts)
             fields.append((cls._LANE_KEEP_LIVE, body))
 
         queued = snapshot.get("delegation_queued")
