+    "stream_cap":              ("HERMES_POOL_STREAM_CAP",              "stream_cap"),
+    "cache_reserve_frac":      ("HERMES_KV_CACHE_RESERVE_FRAC",        "cache_reserve_frac"),
+    "main_slot_reserve":       ("HERMES_POOL_MAIN_SLOT_RESERVE",       "main_slot_reserve"),
+    "total_stream_cap":        ("HERMES_POOL_TOTAL_STREAM_CAP",        "total_stream_cap"),
+    "prefill_rate_tps":        ("HERMES_POOL_PREFILL_RATE_TPS",        "prefill_rate_tps"),
+    "drain_budget_s":          ("HERMES_POOL_DRAIN_BUDGET_S",          "drain_budget_s"),
+    "waste_base_tokens":       ("HERMES_POOL_WASTE_BASE_TOKENS",       "waste_base_tokens"),
+    "waste_growth":            ("HERMES_POOL_WASTE_GROWTH",            "waste_growth"),
+    "prefill_alloc_mib":       ("HERMES_POOL_PREFILL_ALLOC_MIB",       "prefill_alloc_mib"),
+    "prefill_transient_mib":   ("HERMES_POOL_PREFILL_TRANSIENT_MIB",   "prefill_transient_mib"),
+    "vram_hold_max_s":         ("HERMES_POOL_VRAM_HOLD_S",             "vram_hold_max_s"),
+    "hot_token_usage":         ("HERMES_POOL_HOT_TOKEN_USAGE",         "hot_token_usage"),
+    "critical_token_usage":    ("HERMES_POOL_CRITICAL_TOKEN_USAGE",    "critical_token_usage"),
+}
+
+
+def tunable(name: str) -> Any:
+    """Resolve one throttle parameter: env > pool-broker.json > module default.
+
+    The default is read from the UPPERCASE module attribute of the same name, so
+    it stays the single documented source of the value AND stays monkeypatchable.
+    Never raises."""
+    default = globals().get(name.upper())
+    try:
+        env, ckey = _TUNABLE_SPEC[name]
+    except KeyError:
+        return default
+    raw = os.environ.get(env)
+    if raw is None or raw == "":
+        block = _broker_config().get("throttle")
+        if isinstance(block, dict):
+            raw = block.get(ckey)
+    if raw is None or raw == "":
+        return default
+    try:
+        return type(default)(raw) if default is not None else raw
+    except Exception:
+        logger.warning("pool broker: tunable %s=%r is not a %s; using the default %r",
+                       name, raw, type(default).__name__, default)
+        return default
+
+
+def tunables() -> dict:
+    """Every throttle parameter as resolved right now, with where it came from.
+    Published in the allowance so a live retune is visible without a relaunch."""
+    out = {}
+    for name, (env, ckey) in _TUNABLE_SPEC.items():
+        block = _broker_config().get("throttle")
+        src = ("env" if os.environ.get(env) else
+               "config" if isinstance(block, dict) and block.get(ckey) is not None
+               else "default")
+        out[name] = {"value": tunable(name), "source": src}
+    return out
 
 
