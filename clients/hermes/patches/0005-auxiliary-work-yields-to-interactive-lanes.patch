diff --git a/agent/auxiliary_client.py b/agent/auxiliary_client.py
index c0e189d..835d893 100644
--- a/agent/auxiliary_client.py
+++ b/agent/auxiliary_client.py
@@ -8693,6 +8693,260 @@ def _contains_profile_reasoning_fields(value: Any) -> bool:
     return False
 
 
+# ── Background auxiliary work yields to the main lanes on GPU0 ───────────────
+# [bd-dre-x8kyt] Andre: "everything else aux should yield to mains", keeping the
+# goal judge prioritised.
+#
+# WHY A TAG IS NEEDED AT ALL. pool_broker.current_priority() decides priority by
+# WHO the call is for, not what it is: a main agent's auxiliary calls inherit the
+# TURN priority, so titling and curator work fired during a typed turn went out
+# at PRIORITY_INTERACTIVE (100) — tying with the very turn they were stealing
+# prefill from. That inheritance is right for aux the turn is BLOCKED on and
+# wrong for aux nothing is waiting on.
+#
+# WHY AN ALLOW-LIST, NOT A DENY-LIST. Most aux tasks sit on the turn's critical
+# path: the turn cannot finish without its compaction, cannot answer without its
+# vision pass, cannot run a command without its approval verdict, and the goal
+# judge is what keeps an autonomous loop alive (it runs at 100 on purpose via
+# pool_broker.control_plane_call — a USER REQUEST, never demote it). Demoting
+# those would slow the main lane down, which is the opposite of the point. So
+# only tasks with a PROVEN absence of a waiter are listed here; a task not named
+# keeps today's inherited priority. Adding a task to this set is a claim that
+# nothing blocks on it — check the call site before making it.
+#
+#   title_generation  forked to a daemon thread; title_generator.maybe_auto_title
+#                     is explicit that "nothing here is on the critical path"
+#   curator           skill consolidation, runs after the session
+#   monitor           background watcher
+#   background_review a review fork of a finished turn
+#   profile_describer cosmetic profile blurb
+_AUX_BACKGROUND_TASKS: frozenset = frozenset({
+    "title_generation",
+    "curator",
+    "monitor",
+    "background_review",
+    "profile_describer",
+})
+
+
+def _aux_background_priority() -> Optional[int]:
+    """Priority for aux nothing is waiting on, or None to leave the call untagged.
+
+    Defaults to pool_broker's NORMAL (0), which is strictly below an interactive
+    main turn (100) — that is the whole requirement. A value BELOW zero would
+    also yield to subagents; it is reachable through
+    ``HERMES_AUX_BACKGROUND_PRIORITY`` rather than hardcoded, because this
+    backend's acceptance of a negative priority has not been measured and a
+    rejected field fails the call outright.
+
+    ``HERMES_AUX_BACKGROUND_PRIORITY=off`` disables the tag entirely.
+    """
+    raw = (os.environ.get("HERMES_AUX_BACKGROUND_PRIORITY") or "").strip().lower()
+    if raw in {"off", "none", "disabled"}:
+        return None
+    if raw:
+        try:
+            return int(raw)
+        except ValueError:
+            logger.debug("bad HERMES_AUX_BACKGROUND_PRIORITY=%r; using the default", raw)
+    try:
+        from agent.pool_broker import PRIORITY_NORMAL
+        return int(PRIORITY_NORMAL)
+    except Exception:
+        return 0
+
+
+def _apply_aux_background_priority(
+    merged_extra: dict, task: Optional[str], base_url: Optional[str],
+) -> None:
+    """Tag a background aux call so SGLang schedules it behind the main lanes.
+
+    Mutates *merged_extra* in place. Never raises: a priority tag is an
+    optimisation, and an auxiliary call that fails to be deprioritised must
+    still be made.
+
+    ``priority`` set here is FINAL — pool_broker's PriorityTagTransport returns
+    the request unchanged when the body already carries the field
+    (``_tagged_request``: ``if ... "priority" in body: return None``), which is
+    the documented hook this uses instead of editing the broker.
+    """
+    try:
+        if not task or task not in _AUX_BACKGROUND_TASKS:
+            return
+        if "priority" in merged_extra:
+            return          # an explicit caller tag wins
+        from agent.pool_broker import gpu0_hosts
+        host = base_url_hostname(base_url or "")
+        if not host or host not in gpu0_hosts():
+            return          # priority is a GPU0-local scheduling concept
+        prio = _aux_background_priority()
+        if prio is None:
+            return
+        if not _aux_priority_safe():
+            return
+        merged_extra["priority"] = prio
+        logger.debug("auxiliary %s tagged priority=%s (background lane)", task, prio)
+    except Exception:
+        logger.debug("auxiliary priority tag skipped", exc_info=True)
+
+
+# ── Bounded aux context ─────────────────────────────────────────────────────
+# [bd-dre-x8kyt] "a judge doesn't need the full 300K transcript". Aux prompt size
+# is what actually costs the mains: GPU0's radix cache is one shared pool, so a
+# large aux prefix evicts the mains' resident prefixes and their next turn
+# re-prefills from the eviction point. Measured over 24 h: the mains wasted
+# 143,596 prompt tokens per call on re-prefill while an aux request was in flight
+# versus 5,028 when none was — 37.6 M wasted tokens, 8,549 s of prefill that
+# emits no output token.
+#
+# ⛔ EXEMPT BY DESIGN — do not "unify" these under one ceiling:
+#   compression   its input IS the transcript. Truncating it silently discards
+#                 conversation the summary was supposed to preserve. That is
+#                 data loss wearing a performance optimisation's clothes.
+#   vision / web_extract / skills_hub / mcp / approval / moa_*
+#                 the payload the task exists to read. A truncated approval
+#                 verdict or a half-read page is a WRONG answer, not a cheap one.
+#
+# Bounded tasks judge or describe something, so a bounded view still answers the
+# question they were asked. Ceilings are in CHARACTERS: a char budget cannot
+# itself cost a tokenizer pass, and title_generation already uses one
+# (MAX_TITLE_INPUT_CHARS). ~4 chars/token on this tokenizer, so 48,000 chars is
+# roughly 12 K tokens.
+_AUX_PROMPT_CHAR_CEILINGS: Dict[str, int] = {
+    "goal_judge": 48_000,
+    "monitor": 24_000,
+    "curator": 48_000,
+    "profile_describer": 12_000,
+    "triage_specifier": 24_000,
+    "kanban_decomposer": 24_000,
+    "memory_query_rewrite": 8_000,
+    "tts_audio_tags": 8_000,
+}
+
+# Never elide a message below this — a stub carries no information and turns a
+# bounded call into a wasted one.
+_AUX_ELISION_FLOOR = 1_500
+_AUX_ELISION_MARK = "\n\n… [{dropped:,} characters elided to keep this auxiliary call off the mains' prefill budget] …\n\n"
+
+
+def _aux_prompt_ceiling(task: Optional[str]) -> Optional[int]:
+    """Character ceiling for *task*'s prompt, or None to leave it alone.
+
+    ``auxiliary.<task>.max_prompt_chars`` overrides the built-in; ``0`` or a
+    negative value disables bounding for that task.
+    """
+    if not task:
+        return None
+    try:
+        configured = (_get_auxiliary_task_config(task) or {}).get("max_prompt_chars")
+    except Exception:
+        configured = None
+    if configured is not None:
+        try:
+            value = int(configured)
+        except (TypeError, ValueError):
+            logger.debug("bad auxiliary.%s.max_prompt_chars=%r", task, configured)
+        else:
+            return value if value > 0 else None
+    return _AUX_PROMPT_CHAR_CEILINGS.get(task)
+
+
+def _elide_middle(text: str, keep: int) -> str:
+    """Keep the head and tail of *text*, marking what was dropped.
+
+    The middle goes because both ends carry the signal: an aux prompt opens with
+    its instructions and closes with the thing it is actually being asked about.
+    """
+    if keep >= len(text):
+        return text
+    dropped = len(text) - keep
+    mark = _AUX_ELISION_MARK.format(dropped=dropped)
+    room = max(0, keep - len(mark))
+    head = room // 2
+    tail = room - head
+    return text[:head] + mark + (text[len(text) - tail:] if tail else "")
+
+
+def _bound_aux_prompt(messages: list, task: Optional[str]) -> list:
+    """Return *messages* trimmed to *task*'s character ceiling.
+
+    Returns the SAME list object when nothing needs trimming, so the common path
+    allocates nothing. Elides the largest non-system message first: the system
+    message is the stable shared prefix that we WANT resident in the radix cache,
+    and shortening it would defeat the purpose by changing the cache key.
+
+    Never raises — an auxiliary call must not fail because bounding it failed.
+    """
+    if not isinstance(messages, list) or not messages:
+        return messages
+    try:
+        # Inside the guard: the ceiling lookup reads config, and a config read is
+        # exactly the kind of thing that can fail on a half-written file.
+        ceiling = _aux_prompt_ceiling(task)
+        if not ceiling:
+            return messages
+        from agent.message_content import flatten_message_text
+
+        # Only plain-string content is safe to elide: a multimodal block list
+        # carries images, and slicing one would corrupt the payload.
+        sizes = []
+        total = 0
+        for idx, msg in enumerate(messages):
+            if not isinstance(msg, dict):
+                continue
+            content = msg.get("content")
+            length = len(content) if isinstance(content, str) else len(
+                flatten_message_text(content))
+            total += length
+            if isinstance(content, str) and msg.get("role") != "system":
+                sizes.append((length, idx))
+        if total <= ceiling:
+            return messages
+        over = total - ceiling
+        sizes.sort(reverse=True)
+        out = list(messages)
+        elided = 0
+        for length, idx in sizes:
+            if over <= 0:
+                break
+            room = length - _AUX_ELISION_FLOOR
+            if room <= 0:
+                continue
+            take = min(room, over)
+            new_len = length - take
+            out[idx] = dict(out[idx])
+            out[idx]["content"] = _elide_middle(out[idx]["content"], new_len)
+            over -= take
+            elided += take
+        if not elided:
+            return messages
+        logger.warning(
+            "auxiliary %s: prompt bounded %s -> ~%s chars (ceiling %s, %s elided); "
+            "raise auxiliary.%s.max_prompt_chars to widen it",
+            task, f"{total:,}", f"{total - elided:,}", f"{ceiling:,}",
+            f"{elided:,}", task,
+        )
+        return out
+    except Exception:
+        logger.debug("auxiliary prompt bounding skipped for %s", task, exc_info=True)
+        return messages
+
+
+def _aux_priority_safe() -> bool:
+    """Whether this backend will accept a ``priority`` field at all.
+
+    Mirrors pool_broker._priority_safe() through its public allowance rather
+    than reimplementing the flag logic. Fails CLOSED — an unknown backend gets
+    no tag, because ``--abort-on-priority-when-disabled`` turns an unwanted
+    field into a hard request failure.
+    """
+    try:
+        from agent.pool_broker import _priority_safe
+        return bool(_priority_safe())
+    except Exception:
+        return False
+
+
 def _build_call_kwargs(
     provider: str,
     model: str,
@@ -8707,6 +8961,10 @@ def _build_call_kwargs(
     task: Optional[str] = None,
 ) -> dict:
     """Build kwargs for .chat.completions.create() with model/provider adjustments."""
+    # Bound the prompt HERE rather than at the ~20 aux call sites: every retry
+    # and every fallback route rebuilds its kwargs through this function, so a
+    # ceiling applied here holds for all of them [bd-dre-x8kyt].
+    messages = _bound_aux_prompt(messages, task)
     kwargs: Dict[str, Any] = {
         "model": model,
         "messages": messages,
@@ -8895,6 +9153,13 @@ def _build_call_kwargs(
                 sticky_key = None
             if sticky_key:
                 merged_extra["session_id"] = sticky_key
+    # Background aux yields to the main lanes on GPU0 [bd-dre-x8kyt]. Last, so it
+    # sees every other contribution to the body and can defer to an explicit
+    # caller-supplied priority.
+    _apply_aux_background_priority(
+        merged_extra, task,
+        base_url or (_current_custom_base_url() if provider == "custom" else ""),
+    )
     if merged_extra:
         kwargs["extra_body"] = merged_extra
 
diff --git a/agent/background_review.py b/agent/background_review.py
index 7994146..68bc471 100644
--- a/agent/background_review.py
+++ b/agent/background_review.py
@@ -1408,6 +1408,26 @@ def spawn_background_review_thread(
         )
 
     def _target() -> None:
+        # ⛔ THE REVIEW FORK YIELDS TO THE MAIN LANES [bd-dre-x8kyt].
+        # This fork replays a finished turn through a full agent loop, so its
+        # requests go out on the MAIN client path, not through auxiliary_client
+        # — the aux background-priority tag cannot reach them. Measured: 1,716
+        # review calls carrying 55.4 M prompt tokens (mean ~32 K, plus 260 M
+        # cache-read) on the same GPU0 card the live lanes prefill on.
+        #
+        # A bare thread starts with an EMPTY context on 3.11, so without this
+        # the fork inherits nothing and lands at NORMAL by default — which is
+        # already right today, but only by accident: it would silently become
+        # INTERACTIVE the moment this thread started inheriting its parent's
+        # context. Set it explicitly so the property is stated, not incidental.
+        # Nobody waits on a post-turn review, so it never outranks a live turn.
+        try:
+            from agent.pool_broker import PRIORITY_NORMAL, set_turn_priority
+
+            set_turn_priority(PRIORITY_NORMAL)
+        except Exception:
+            logger.debug("background review: priority demotion skipped",
+                         exc_info=True)
         _run_review_in_thread(agent, messages_snapshot, prompt, task_cfg)
 
     return _target, prompt
