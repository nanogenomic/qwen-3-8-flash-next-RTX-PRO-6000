-    title = generate_title(
+    title = None if skip_llm else generate_title(
         user_message,
         failure_callback=failure_callback,
         main_runtime=main_runtime,
@@ -700,6 +713,35 @@ def _session_is_untitled(session_db, session_id: str) -> bool:
         return False
 
 
+def _is_one_shot_session() -> bool:
+    """Whether this process is a ``hermes -q`` / ``-Q`` single-query run.
+
+    ``HERMES_SINGLE_QUERY_SESSION`` is set by cli.py for exactly that case.
+    Prefers the session-context lookup (a gateway-hosted session carries its own
+    environment) and falls back to ``os.environ``, which is what a plain CLI run
+    has. Fails OPEN — an unreadable marker must not disable titling for real
+    interactive sessions, so an error here means "not one-shot".
+
+    ``HERMES_TITLE_ONE_SHOT=1`` restores LLM titling for one-shot runs.
+    """
+    try:
+        if os.environ.get("HERMES_TITLE_ONE_SHOT", "").strip() == "1":
+            return False
+        value = ""
+        try:
+            from gateway.session_context import get_session_env
+
+            value = get_session_env("HERMES_SINGLE_QUERY_SESSION", "")
+        except Exception:
+            value = ""
+        if not str(value).strip():
+            value = os.environ.get("HERMES_SINGLE_QUERY_SESSION", "")
+        return str(value).strip().lower() not in ("", "0", "false", "no", "off")
+    except Exception:
+        logger.debug("one-shot session check failed; titling as usual", exc_info=True)
+        return False
+
+
 def maybe_auto_title(
     session_db,
     session_id: str,
@@ -747,6 +789,32 @@ def maybe_auto_title(
 
     apply_instant_title(session_db, session_id, user_message, title_callback)
 
+    # ⛔ A ONE-SHOT ``-q`` / ``-Q`` SESSION GETS THE DERIVED TITLE AND NOTHING
+    # MORE [bd-dre-x8kyt]. The instant title above has already landed, so the
+    # session is named either way; what is skipped is the LLM upgrade, and the
+    # upgrade only pays for itself if someone later BROWSES a session list.
+    # Nobody browses these: a one-shot run prints its answer to a pipe and exits,
+    # and it is overwhelmingly a script rather than a person (the same marker is
+    # why the approval gate takes its deterministic path — "a -q run has NO user
+    # waiting"). Measured on the architect profile: 258 of these per day, one per
+    # hermes-monitor tick, every one titling a session no human would ever list,
+    # each landing a request on the GPU0 card the main lanes are prefilling on.
+    #
+    # The stage still RUNS, with ``skip_llm`` — it is the only thing that
+    # recovers a derived-title COLLISION, because apply_instant_title above
+    # passes dedupe=False and so writes nothing when the name is taken. On a
+    # machine lane it is taken every time (the monitor's suffix counter had
+    # reached #905), so returning here instead would trade 258 model calls for
+    # 258 nameless sessions. Skipping only the model call keeps both.
+    #
+    # Read through get_session_env so a gateway-hosted session sees its OWN
+    # environment rather than the host process's.
+    _one_shot = _is_one_shot_session()
+    if _one_shot:
+        logger.debug(
+            "Auto-title: derived title only, no model call "
+            "(one-shot -q session; nothing lists it)")
+
     thread = threading.Thread(
         target=auto_title_session,
         args=(session_db, session_id, user_message),
@@ -755,6 +823,7 @@ def maybe_auto_title(
             "main_runtime": main_runtime,
             "title_callback": title_callback,
             "runtime_validator": runtime_validator,
+            "skip_llm": _one_shot,
         },
         daemon=True,
         name="auto-title",
diff --git a/cli.py b/cli.py
index 9470123..9651118 100644
--- a/cli.py
+++ b/cli.py
@@ -1580,6 +1580,49 @@ def _raise_single_query_async_incomplete(cli, residue: list[dict]) -> None:
     raise SystemExit(_SINGLE_QUERY_ASYNC_INCOMPLETE_EXIT_CODE)
 
 
+def turn_request_priority(auto_kind, one_shot: bool):
+    """SGLang request priority for the turn about to run: ``(priority, why)``.
+
+    [bd-dre-i4qoy] Interactive (100) when a human started the turn, normal (0)
+    when the agent scheduled it.
+
+    ⛔ A ONE-SHOT ``-q`` / ``-Q`` RUN IS NOT INTERACTIVE [bd-dre-x8kyt].
+    The classifier used to split only "the agent scheduled this turn" from
+    everything else, so a SCRIPT piping a prompt in fell through to INTERACTIVE
+    and competed with Andre's typed turn on GPU0 at EQUAL priority — the one
+    thing priority scheduling exists to prevent. Measured over 24 h on the
+    architect profile: the hermes-monitor loop (``hermes chat -Q -q``, every
+    240 s) issued 305 calls carrying 12.9 M prompt tokens — mean 42,340, a fresh
+    full system prompt per tick — to produce 222 K output tokens, every one of
+    them at priority 100 against two 270 K-context main lanes.
+
+    ``_single_query_mode`` already carries the fact this relies on; cli.py states
+    it outright where the marker is set: "a -q run has NO user waiting to answer
+    approval prompts". Nobody waits on the latency, so the turn yields to the
+    lanes where somebody does.
+
+    Deliberately NOT keyed on ``isatty()``: a human running ``hermes -q`` from an
+    interactive shell still has no turn-by-turn loop blocked on it, and a tmux
+    main lane is not reliably a tty either.
+
+    Returns ``(None, why)`` when pool_broker cannot be imported, which leaves the
+    request untagged exactly as before.
+    """
+    if auto_kind:
+        why = f"autonomous: {auto_kind}"
+    elif one_shot:
+        why = "one-shot -q/-Q: no user waiting, yields to main lanes"
+    else:
+        why = "interactive"
+    try:
+        from agent.pool_broker import PRIORITY_INTERACTIVE, PRIORITY_NORMAL
+    except Exception:
+        return None, why
+    if auto_kind or one_shot:
+        return PRIORITY_NORMAL, why
+    return PRIORITY_INTERACTIVE, why
