+# Copyright © 2026 Ligandal, Inc. All rights reserved.
+"""Auxiliary work must not compete with the main lanes on GPU0 [bd-dre-x8kyt].
+
+GPU1 is training and the 27B lane is off-limits, so the "put aux on the other
+card" plan (bd-dre-oh6sp.32) is unavailable. Aux has to share GPU0 and simply
+cost the mains less. Three mechanisms do that, and these tests pin each one
+together with the case it must NOT change:
+
+1. A one-shot ``-q`` turn yields (``cli.turn_request_priority``). Measured: the
+   hermes-monitor loop's 305 calls/24 h, 12.9 M prompt tokens, ran at the same
+   priority 100 as Andre's typed turn.
+2. Background aux carries an explicit low ``priority`` so SGLang schedules it
+   behind the mains — and the goal judge NEVER does, because Andre asked for it
+   to stay prioritised.
+3. Judge-shaped aux prompts are bounded, because a large aux prefix evicts the
+   mains' radix entries. Measured: the mains wasted 143,596 prompt tokens per
+   call on re-prefill while an aux request was in flight versus 5,028 when none
+   was.
+
+The exemptions matter as much as the mechanisms: truncating ``compression`` would
+silently discard transcript the summary exists to preserve, and demoting the
+aux a turn is BLOCKED on would slow the main lane down — the opposite of the
+point. Both are asserted here so a later "unify the ceilings" refactor fails
+loudly.
+"""
+from __future__ import annotations
+
+import os
+
+import pytest
+
+import agent.auxiliary_client as aux
+import agent.title_generator as tg
+
+
+GPU0 = "http://127.0.0.1:30000/v1"
+OFFHOST = "https://api.openai.com/v1"
+
+
+@pytest.fixture(autouse=True)
+def _priority_is_taggable(monkeypatch):
+    """Pretend the backend accepts a priority field, and that GPU0 is GPU0.
+
+    Both are read from the live pool broker in production; pinning them keeps
+    these tests independent of whether a server happens to be up.
+    """
+    monkeypatch.setattr(aux, "_aux_priority_safe", lambda: True)
+    import agent.pool_broker as pb
+    monkeypatch.setattr(pb, "gpu0_hosts", lambda: frozenset({"127.0.0.1"}))
+    monkeypatch.delenv("HERMES_AUX_BACKGROUND_PRIORITY", raising=False)
+
+
+# ── 1. one-shot turns yield ──────────────────────────────────────────────────
+
+def test_one_shot_turn_is_not_interactive():
+    import cli
+    from agent.pool_broker import PRIORITY_INTERACTIVE, PRIORITY_NORMAL
+
+    prio, why = cli.turn_request_priority(None, True)
+    assert prio == PRIORITY_NORMAL
+    assert "one-shot" in why
+    # The regression this exists for: it used to come back at 100.
+    assert prio != PRIORITY_INTERACTIVE
+
+
+def test_typed_turn_keeps_interactive_priority():
+    import cli
+    from agent.pool_broker import PRIORITY_INTERACTIVE
