+# ── 3. bounded aux context ───────────────────────────────────────────────────
+
+def _msgs(system_chars: int, user_chars: int) -> list:
+    return [{"role": "system", "content": "S" * system_chars},
+            {"role": "user", "content": "U" * user_chars}]
+
+
+def test_a_judge_prompt_is_bounded():
+    ceiling = aux._AUX_PROMPT_CHAR_CEILINGS["goal_judge"]
+    out = aux._bound_aux_prompt(_msgs(2_000, 300_000), "goal_judge")
+    assert sum(len(m["content"]) for m in out) <= ceiling
+
+
+def test_bounding_never_shortens_the_shared_system_prefix():
+    """The system message is the prefix we WANT resident in the radix cache;
+    changing it changes the cache key and defeats the purpose."""
+    msgs = _msgs(2_000, 300_000)
+    out = aux._bound_aux_prompt(msgs, "goal_judge")
+    assert out[0]["content"] == msgs[0]["content"]
+
+
+def test_bounding_keeps_both_ends_of_the_elided_message():
+    msgs = [{"role": "system", "content": "sys"},
+            {"role": "user", "content": "HEAD" + "x" * 300_000 + "TAIL"}]
+    out = aux._bound_aux_prompt(msgs, "goal_judge")
+    body = out[1]["content"]
+    assert body.startswith("HEAD")
+    assert body.endswith("TAIL")
+    assert "elided" in body
+
+
+def test_a_short_prompt_is_returned_unchanged_and_unallocated():
+    msgs = _msgs(100, 100)
+    assert aux._bound_aux_prompt(msgs, "goal_judge") is msgs
+
+
+def test_compression_input_is_never_truncated():
+    """Its input IS the transcript. Truncating it is data loss wearing a
+    performance optimisation's clothes."""
+    assert "compression" not in aux._AUX_PROMPT_CHAR_CEILINGS
+    msgs = _msgs(2_000, 900_000)
+    assert aux._bound_aux_prompt(msgs, "compression") is msgs
+
+
+@pytest.mark.parametrize("task", ["vision", "web_extract", "skills_hub",
+                                 "mcp", "approval", "moa_reference",
+                                 "moa_aggregator", "compression"])
+def test_payload_reading_tasks_have_no_ceiling(task):
+    assert aux._aux_prompt_ceiling(task) is None
+
+
+def test_multimodal_content_is_never_sliced():
+    """A block list carries images; slicing one corrupts the payload."""
+    msgs = [{"role": "system", "content": "sys"},
+            {"role": "user", "content": [{"type": "text", "text": "T" * 300_000},
+                                         {"type": "image_url",
+                                          "image_url": {"url": "data:image/png;base64,AAAA"}}]}]
+    out = aux._bound_aux_prompt(msgs, "goal_judge")
+    assert out[1]["content"] == msgs[1]["content"]
+
+
+def test_no_message_is_elided_below_the_information_floor():
+    msgs = [{"role": "system", "content": "sys"},
+            {"role": "user", "content": "U" * 300_000}]
+    out = aux._bound_aux_prompt(msgs, "goal_judge")
+    assert len(out[1]["content"]) >= aux._AUX_ELISION_FLOOR
+
+
+def test_config_can_widen_or_disable_the_ceiling(monkeypatch):
