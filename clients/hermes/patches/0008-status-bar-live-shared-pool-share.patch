+        _publish({me: 196_608, me + 1: 196_608})
+        row = _rows(prompt=174_615)[0]
+        assert " 44%" in row and "100%" not in row
+
+    def test_the_marker_earns_the_attention_colour_not_the_alarm_colour(self):
+        me = os.getpid()
+        _publish({me: 196_608, me + 1: 196_608})
