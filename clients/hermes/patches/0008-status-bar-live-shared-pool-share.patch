+# ---------------------------------------------------------------------------
+# Loans
+# ---------------------------------------------------------------------------
+
+class TestLoans:
+    def test_the_borrower_and_the_lender_are_named_differently(self):
+        """The asymmetric pair the broker produces when one main is busy at 433K
+        and the other idle at 40K: 270,336 / 131,072 via a revocable loan."""
