--- /dev/null
+++ b/hermes_cli/pool_share.py
@@ -0,0 +1,441 @@
+# Copyright © 2026 Ligandal, Inc. All rights reserved.
+"""DISPLAY-ONLY view of the shared GPU0 KV pool, for the CLI status bar.
+
+⛔ WHY THIS EXISTS.  ``agent/pool_broker.py`` publishes a per-session,
+share-bounded window grant about every 5 s — ``sessions[<pid>].main_window`` and
+``main_grow_max``, bounded against the LIVE ``max_total_num_tokens`` since
+``301b96a`` [bd-dre-x3n0x].  The status bar never read it.  Its ``ctx`` field
+divided by the *static profile* ``context_length`` instead, so two architect
+mains sharing one 451,264-token pool both rendered ``ctx 159K/393.2K`` and
+``ctx 224K/393.2K`` — 786,432 tokens of claimed window against a 451,264-token
+pool, with nothing on screen saying they were sharing it or that the broker's
+real grant was 196,608 each.  Andre, 2026-09-30: *"shouldn't they dynamically
+adjust each other including in the hermes GUI?"* [bd-dre-hxxze]
+
+⛔ WHAT THIS MODULE MAY NOT DO.  It is a READER.  It never writes the document,
+never probes the backend or the router, never calls
+``pool_broker.get_allowance()`` (which may refresh over the network and would
+stall a repaint on the UI thread), and it never touches a live agent's
+geometry.  Nothing here can lower a window, raise one, or trigger a compaction:
+the only thing it produces is text.  Andre, 2026-09-30: *"i like long context
+and our speeds are still good"* — the point is honest sharing and visibility,
+never a smaller window.
+
+⛔ WHAT IT SHOWS.  Three separate facts, which the old single number conflated:
+
+  * **the ceiling this lane may actually occupy right now** — the broker's grant
+    when the grant can be adopted without forcing a compaction, otherwise the
+    window the session is genuinely holding (see :func:`lane_share`);
+  * **the pool it comes out of** and **how many mains are dividing it**, so a
+    denominator that halves when a peer launches is legible rather than
+    mysterious;
+  * **over-share**, when this session holds more than its share.  That is a
+    REAL, legitimate state — the broker calls it *grandfathered* and only a
+    relaunch clears it — so it is displayed honestly rather than treated as an
+    error, and it never provokes a shrink from the display path.
+
+Degradation, in the order the cases actually happen:
+
+  * **document absent** (broker disabled, a non-GPU0 backend, a fresh install) →
+    ``present=False``; the bar keeps the static behaviour exactly.
+  * **document stale** → ``fresh=False``.  The threshold is
+    ``DISPLAY_MAX_AGE_S`` = 90 s, the same age the broker allows its serving-host VRAM
+    sample (``pool_broker.VRAM_SAMPLE_MAX_AGE_S``); the document itself is
+    rewritten every ~5 s, so 90 s means the publisher is gone, not merely busy.
+  * **document written by an OLDER peer** whose ceilings are not share-bounded
+    (Andre's two sessions published exactly this until 301b96a landed) →
+    ``bounded=False``.  A grant above the pool ceiling, or grants that sum above
+    it, is not a grant: it is the pre-fix unbounded number, and quoting it as
+    "your share" would be a worse lie than the static config was.
+"""
+
+from __future__ import annotations
+
+import os
+import threading
+from pathlib import Path
+from typing import Any, Dict, Optional, Tuple
+
+#: A document older than this is not shown as the live share.  Matches
+#: ``pool_broker.VRAM_SAMPLE_MAX_AGE_S`` — the precedent in this codebase for
+#: "a sample this old is not evidence about now" — and is 18x the broker's own
+#: ~5 s publish interval, so it only trips when the publisher has actually died.
+DISPLAY_MAX_AGE_S = float(os.environ.get("HERMES_POOL_DISPLAY_MAX_AGE_S", "90"))
+
+#: Parsed-document cache, keyed on the file's identity rather than on a clock:
+#: ``(path, mtime_ns, size)``.  The status bar repaints on a timer and every
+#: repaint asks for this view, so the parse must not repeat — but a TTL would
+#: also make a freshly-written document invisible for up to the TTL, which is
+#: exactly the "show it changing" behaviour this module exists to provide.  A
+#: stat() per repaint costs microseconds; a json parse of a ~4 KB document is
+#: only paid when the broker has actually rewritten it.
+_cache: Dict[str, Any] = {"key": None, "doc": None}
+_cache_lock = threading.Lock()
+
+
+def invalidate() -> None:
+    """Drop the parsed-document cache (tests; never needed in production)."""
+    with _cache_lock:
+        _cache["key"] = None
+        _cache["doc"] = None
+
+
+def document_path() -> Optional[Path]:
+    """Where the broker publishes, resolved the way the broker resolves it.
+
+    Deliberately routed through ``pool_broker._allowance_path()`` rather than
+    rebuilt here: the test suite's isolation fixture repoints that one function
+    at a per-test tempdir, and a second copy of the path logic would walk
+    straight past the guard and read (or, in a future edit, write) live
+    production state.
+    """
+    try:
+        from agent import pool_broker as pb
+
+        return Path(pb._allowance_path())
+    except Exception:
+        return None
+
+
+def read_document(path: Optional[Path] = None,
+                  now: Optional[float] = None) -> Tuple[Optional[dict], float]:
+    """``(document, age_seconds)``; ``(None, inf)`` when unreadable.
+
+    Pure read.  No lock is taken on the file: the broker writes it atomically
+    (temp file + rename), so a reader either sees the whole previous document or
+    the whole new one, and a torn parse degrades to ``(None, inf)`` anyway.
+    """
+    import json
+    import time
+
+    now = time.time() if now is None else now
+    try:
+        p = Path(path) if path is not None else document_path()
+        if p is None:
+            return None, float("inf")
+        st = p.stat()
+        key = (str(p), st.st_mtime_ns, st.st_size)
+        with _cache_lock:
+            if _cache["key"] == key:
+                doc = _cache["doc"]
+                if doc is None:
+                    return None, float("inf")
+                return doc, max(0.0, now - float(doc.get("updated") or 0.0))
+        doc = json.loads(p.read_text(encoding="utf-8"))
+        if not isinstance(doc, dict):
+            doc = None
+        with _cache_lock:
+            _cache["key"], _cache["doc"] = key, doc
+        if doc is None:
+            return None, float("inf")
+        return doc, max(0.0, now - float(doc.get("updated") or 0.0))
+    except Exception:
+        return None, float("inf")
+
+
+def _grant_of(entry: object) -> int:
+    """The window a session entry says its lane may occupy, in tokens.
+
+    ``max`` of the two published ceilings on purpose.  ``pool_policy`` lets
+    ``main_grow_max`` sit BELOW ``main_window`` — that is how "hold what you
+    have but stop growing" is expressed — so the smaller of the pair is a growth
+    stop, not a statement that the lane may not run at the window it was
+    granted.
+    """
+    if not isinstance(entry, dict):
+        return 0
+    try:
+        return max(int(entry.get("main_window") or 0),
+                   int(entry.get("main_grow_max") or 0))
+    except Exception:
+        return 0
+
+
+def _trigger_for(window: int, max_tokens: int, threshold_percent: float) -> int:
+    """Compaction trigger for ``window``, via the broker's own arithmetic.
+
+    ``pool_broker.footprint`` is the single definition of this in the codebase
+    (a faithful port of ``ContextCompressor._compute_threshold_tokens``).
+    Calling it keeps the display's "could this grant be adopted right now?" test
+    identical to the one ``ContextCompressor._maybe_pool_adopt_share`` applies
+    when it actually adopts — so the bar can never promise a ceiling the
+    compressor would refuse, or refuse one it is about to take.  0 on any
+    failure, which reads as "not adoptable" and keeps the held window.
+    """
+    try:
+        from agent import pool_broker as pb
+
+        return int(pb.footprint(int(window), int(max_tokens or 0),
+                                float(threshold_percent or 0.5)))
+    except Exception:
+        return 0
+
+
+def lane_share(doc: Optional[dict], *, pid: Optional[int] = None,
+               window: int = 0, prompt_tokens: int = 0, max_tokens: int = 0,
+               threshold_percent: float = 0.5, age_s: float = 0.0,
+               max_age_s: Optional[float] = None) -> Dict[str, Any]:
+    """Turn the published document into the numbers the bar renders.
+
+    ``window`` is this session's LIVE window (``ContextCompressor.context_length``),
+    not the profile's configured one — it already moves when the compressor grows
+    or adopts, and it is the only local truth about what the session holds.
+
+    The returned ``ceiling`` is what the bar should divide by, chosen by the one
+    test that decides whether the grant is real for this session right now:
+
+      * ``grant >= window`` — the grant is headroom the compressor will grow
+        into, so the grant is the ceiling;
+      * ``grant < window`` but the grant's trigger is still above the resident
+        prompt — the compressor will settle onto the grant without compacting
+        anything, so the grant is the ceiling;
+      * ``grant < window`` and the grant's trigger is already below the resident
+        prompt — the grant CANNOT be applied without forcing a compaction the
+        broker did not ask for, so the session keeps the window it holds.  That
+        is ``over_share``: honest, expected, cleared only by a relaunch, and
+        explicitly never a reason for the display to shrink anything.
+
+    Never raises.  Every field is present on every path.
+    """
+    limit = DISPLAY_MAX_AGE_S if max_age_s is None else float(max_age_s)
+    window = max(0, int(window or 0))
+    view: Dict[str, Any] = {
+        "present": False,
+        "fresh": False,
+        "stale": False,
+        "age_s": float(age_s),
+        "max_age_s": limit,
+        "pool": None,
+        "n_mains": None,
+        "peers": None,
+        "grant": None,
+        "bounded": False,
+        "usable": False,
+        "ceiling": window or None,
+        "ceiling_source": "window",
+        "over_share": False,
+        "over_tokens": 0,
+        "loan": "",
+        "reason": "",
+    }
+    try:
+        if not isinstance(doc, dict) or not doc:
+            return view
+        view["present"] = True
+        if age_s > limit:
+            view["stale"] = True
+            return view
+        view["fresh"] = True
+
+        # The LIVE pool, read from the document every repaint. A concurrent
+        # effort may raise it to ~1.31M via host-RAM KV offload; nothing here
+        # needs editing for that -- the number simply changes.
+        ceiling_tokens = 0
+        for key in ("ceiling", "pool"):
+            try:
+                ceiling_tokens = int(doc.get(key) or 0)
+            except Exception:
+                ceiling_tokens = 0
+            if ceiling_tokens > 0:
+                break
+        view["pool"] = ceiling_tokens or None
+        try:
+            n_mains = int(doc.get("n_mains") or 0)
+        except Exception:
+            n_mains = 0
+        sessions = doc.get("sessions")
+        if not isinstance(sessions, dict):
+            sessions = {}
+        if not n_mains:
+            n_mains = len(sessions)
+        view["n_mains"] = n_mains or None
+        view["peers"] = max(0, n_mains - 1) if n_mains else None
+
+        me = str(int(pid if pid is not None else os.getpid()))
+        mine = sessions.get(me)
+        grant = _grant_of(mine)
+        if isinstance(mine, dict):
+            # The broker's own sentence about why this grant is what it is.
+            # Not rendered on the bar (no room) -- carried for /pool-style
+            # detail and for a log line that has to explain a denominator.
+            view["reason"] = str(mine.get("reason") or "")
+        if not grant:
+            return view                      # not a main on this pool
+        view["grant"] = grant
+
+        # ⛔ OLD PEER, UNBOUNDED CEILINGS. Before 301b96a the broker handed every
+        # main the whole pool (main_window == main_grow_max == pool), which is
+        # what Andre's two sessions were publishing minutes before this shipped.
+        # Such a number is not a share and must not be quoted as one: a grant
+        # above the pool, or grants that sum above it, means whoever refreshed
+        # the document last is running pre-fix policy.
+        #
+        # The test is ``sum > ceiling``, not ``sum >= ceiling``, on purpose. A
+        # LONE main legitimately gets the whole pool — the current policy hands
+        # it exactly ``ceiling`` at a 1,310,720 pool — and one main cannot
+        # starve anyone, which is why the 2026-09-30 deadlock needed two. So
+        # grants that sum TO the ceiling are a valid split; only a sum above it
+        # is the oversubscription that wedged the pool.
+        grants = [_grant_of(v) for v in sessions.values()]
+        granted_sum = sum(g for g in grants if g > 0)
+        if ceiling_tokens and (grant > ceiling_tokens or granted_sum > ceiling_tokens):
+            return view                      # bounded stays False
+        view["bounded"] = True
+        view["usable"] = True
+
+        # Asymmetric grants mean the broker lent part of an idle main's share to
+        # a busy one -- revocable, and worth saying so the denominator moving
+        # back down later is not a surprise.
+        others = [g for k, g in zip(sessions.keys(), grants) if k != me and g > 0]
+        if others:
+            if grant > max(others):
+                view["loan"] = "borrow"
+            elif grant < min(others):
+                view["loan"] = "lend"
+
+        if not window or grant >= window:
+            view["ceiling"] = grant
+            view["ceiling_source"] = "grant"
+        elif _trigger_for(grant, max_tokens, threshold_percent) > int(prompt_tokens or 0):
+            # Adoptable now: lowering the window would not force a compaction,
+            # so the grant is what this lane may actually occupy.
+            view["ceiling"] = grant
+            view["ceiling_source"] = "grant"
+        else:
+            # Holding more than the share. Keep the held window as the ceiling
+            # -- it is what the session really has, and the broker will not take
+            # it back -- and flag the over-share so the bar can say both.
+            view["ceiling"] = window
+            view["ceiling_source"] = "window"
+            view["over_share"] = True
+            view["over_tokens"] = max(0, window - grant)
+        return view
+    except Exception:
+        return view
+
+
+def get_lane_share(*, pid: Optional[int] = None, window: int = 0,
+                   prompt_tokens: int = 0, max_tokens: int = 0,
+                   threshold_percent: float = 0.5,
+                   path: Optional[Path] = None) -> Dict[str, Any]:
+    """:func:`lane_share` against the document on disk.  Never raises, never
+    blocks on the network, safe to call from a repaint."""
+    doc, age = read_document(path)
+    return lane_share(doc, pid=pid, window=window, prompt_tokens=prompt_tokens,
+                      max_tokens=max_tokens, threshold_percent=threshold_percent,
+                      age_s=age)
+
+
+# --------------------------------------------------------------------- render
+def _compact(tokens: int) -> str:
+    """``451264`` → ``451.3K``.  Shares the banner's formatter so the share
+    field and the ``ctx`` field it sits next to can never disagree about how a
+    token count is spelled."""
+    try:
+        from hermes_cli.banner import _format_context_length
+
+        return _format_context_length(int(tokens))
+    except Exception:
+        return str(int(tokens))
+
+
+def _age_label(age_s: float) -> str:
+    try:
+        age = int(max(0.0, float(age_s)))
+    except Exception:
+        return "?"
+    if age < 90:
+        return f"{age}s"
+    if age < 5400:
+        return f"{age // 60}m"
+    return f"{age // 3600}h"
+
+
+#: Minimum pane width that gets the spelled-out share field.  Both Hermes panes
+#: on this host are 220-224 columns.  Measured at 160: the architect row is 154
+#: cells with the field, so it fits with the bar's usual complement of counters.
+WIDE_MIN_WIDTH = 160
+
+#: Between this and :data:`WIDE_MIN_WIDTH`, only a MARKER state earns cells —
+#: over-share, a loan, unbounded ceilings, a dead publisher.  The ``ctx``
+#: denominator already carries the live grant, which is the part that was
+#: actually wrong, and it costs nothing.  Below this the field is dropped
+#: entirely: measured at 120 the architect row is already 110 cells, so a
+#: 22-cell field would push the tail (``↯ tok/s``, the turn timer) off the edge,
+#: and trading two live counters for a static one is the trade the two-row
+#: layout was built to stop making.
+MARKER_MIN_WIDTH = 140
+
+
+def share_segment(view: Optional[Dict[str, Any]], *, width: int = 224) -> str:
+    """One compact status-bar field for the sharing state, or ``""``.
+
+    ``⇄`` is the only glyph added.  U+21C4 is East-Asian-Width *Neutral* and
+    ``get_cwidth`` scores it 1 — the same class and score as ``⇉`` (U+21C9),
+    which was measured against this TUI's terminal in
+    ``tests/cli/test_cli_status_bar_column_drift``.  That agreement is not
+    cosmetic: prompt_toolkit repaints the bar differentially, so one cell of
+    disagreement between its column model and the terminal's splices two frames
+    together (see ``cli._strip_presentation_selectors``).  ``▲`` and ``⚠`` are
+    both already in the measured set.
+    """
+    if not isinstance(view, dict) or not view.get("present"):
+        return ""
+    cells = int(width or 0)
+    if cells < MARKER_MIN_WIDTH:
+        return ""
+    wide = cells >= WIDE_MIN_WIDTH
+    if view.get("stale"):
+        # Say the pool read-out is old rather than quoting old numbers as now.
+        return f"⇄ pool stale {_age_label(view.get('age_s') or 0)} ⚠"
+
+    if not view.get("grant"):
+        # This process is not a main on the shared pool (a subagent, a lane on
+        # another backend, a session the broker has not seen yet). It has no
+        # share, so it spends no cells claiming one -- and must not imply that
+        # the ceiling the bar is showing came from the pool.
+        return ""
+
+    pool = view.get("pool")
+    n_mains = view.get("n_mains")
+    marks = []
+    if not view.get("bounded"):
+        # An older peer is publishing ceilings that are not share-bounded, so
+        # there is no trustworthy share to name -- only the pool and the peers.
+        marks.append("no share cap ⚠")
+    else:
+        if view.get("over_share") and view.get("grant"):
+            marks.append(f"share {_compact(int(view['grant']))} ▲")
+        loan = view.get("loan")
+        if loan == "borrow":
+            marks.append("+loan")
+        elif loan == "lend":
+            marks.append("-loan")
+
+    if not wide:
+        # Markers only; the denominator carries the rest.
+        return ("⇄ " + " · ".join(marks)) if marks else ""
+
+    parts = []
+    if n_mains:
+        parts.append(f"{int(n_mains)} main" + ("" if int(n_mains) == 1 else "s"))
+    if pool:
+        parts.append(f"{_compact(int(pool))} pool")
+    parts.extend(marks)
+    return ("⇄ " + " · ".join(parts)) if parts else ""
+
+
+def segment_style(view: Optional[Dict[str, Any]]) -> str:
+    """prompt_toolkit style class for :func:`share_segment`.
+
+    Orange (``status-bar-bad``) for the two states a reader should notice —
+    holding more than the share, and a peer publishing unbounded ceilings — and
+    dim for ordinary sharing.  Deliberately NOT the red YOLO class: neither
+    state is an error, and neither is anything the operator must act on.
+    """
+    if isinstance(view, dict) and (
+        view.get("stale") or view.get("over_share") or (
+            view.get("grant") and not view.get("bounded"))
+    ):
+        return "class:status-bar-bad"
+    return "class:status-bar-dim"
