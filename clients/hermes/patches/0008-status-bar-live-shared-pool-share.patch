+    def test_every_glyph_keeps_the_column_agreement_the_bar_depends_on(self):
+        """prompt_toolkit repaints the bar differentially, so one cell of
+        disagreement between its column model and the terminal's splices two
+        frames together. ⇄ (U+21C4) is East-Asian-Width Neutral and scores 1 --
+        the same class and score as ⇉ (U+21C9), measured against this TUI's
+        terminal in tests/cli/test_cli_status_bar_column_drift."""
+        import unicodedata
