+# Copyright © 2026 Ligandal, Inc. All rights reserved.
+"""The status bar's ``ctx`` denominator is the LIVE pool share. [bd-dre-hxxze]
+
+Measured before this shipped, on Andre's two architect panes right after a
+relaunch::
+
+    ⚕ opus-4.7 (architect) │ ctx 175K/393.2K │ [████░░░░░░] 44% │ 🗜 2 │ …
+    ⚕ opus-4.7 (architect) │ ctx 234K/393.2K │ [██████░░░░] 60% │ 🗜 2 │ …
+
+393.2K each — the static profile ``context_length`` — against a 451,264-token
+shared KV pool, while the broker was granting each of them 196,608.  Nothing on
+either bar said they were sharing anything.  Andre: *"shouldn't they dynamically
+adjust each other including in the hermes GUI?"*
+
+After::
+
+    ⚕ opus-4.7 (architect) │ ctx 175K/393.2K │ [████░░░░░░] 44% │ ⇄ 2 mains · 451.3K pool · share 196.6K ▲ │ 🗜 2 │ …
+
+and for a session whose prompt still fits under its share, the denominator
+itself becomes the grant::
+
+    ⚕ opus-4.7 (architect) │ ctx 40K/196.6K │ [██░░░░░░░░] 20% │ ⇄ 2 mains · 451.3K pool │ 🗜 2 │ …
+
+⛔ THE DISPLAY PATH MAY NOT TOUCH THE AGENT.  ``TestNoDisplayPathSideEffects``
+renders through a compressor that turns any attribute WRITE, and any call to a
+compaction entry point, into a test failure — because the one thing this feature
+must never do is make a bar repaint shrink a live session.  Andre: *"i like long
+context and our speeds are still good."*
+"""
+
+import json
+import os
+import time
+from datetime import datetime, timedelta
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+import agent.pool_broker as pb
+from cli import HermesCLI
+from hermes_cli import pool_share as ps
+
+WIDTH = 220                  # the peer pane:1.1, Andre's architect pane
+LIVE_POOL = 451_264
+BIG_POOL = 1_310_720
+CONFIGURED = 393_216         # profiles/architect context_length
+MAIN_MT = 8_192
+ARCHITECT_PCT = 0.85
+
+LANE = {
+    "model": "qwen38-27b-agent", "role": "agent", "up": True,
+    "kv_used": 384_960, "kv_total": LIVE_POOL, "percent": 85,
+    "streams": 4, "slots": 4, "queued": 2,
+    "total_tps": 182.4, "stream_tps": 45.6,
+}
+
+
+# ---------------------------------------------------------------------------
+# Fixtures
+# ---------------------------------------------------------------------------
+
+class _FrozenCompressor:
+    """A compressor the display path can only READ.
+
+    Any attribute write, and any call to a compaction or window-moving entry
+    point, raises. That is the invariant under test: a status-bar repaint reads
+    the broker's grant and renders text, and it must be structurally incapable
+    of applying it.
+    """
+
+    _FORBIDDEN = (
+        "should_compress", "should_compress_info", "compress",
+        "compress_conversation", "_maybe_pool_grow", "_maybe_pool_adopt_share",
+        "_maybe_governor_autoraise", "_pool_heartbeat",
+    )
+
+    def __init__(self, **fields):
+        object.__setattr__(self, "_fields", dict(fields))
+
+    def __getattr__(self, name):
+        fields = object.__getattribute__(self, "_fields")
+        if name in fields:
+            return fields[name]
+        if name in _FrozenCompressor._FORBIDDEN:
+            raise AssertionError(f"the display path called {name}()")
+        raise AttributeError(name)
+
+    def __setattr__(self, name, value):          # pragma: no cover - a failure
+        raise AssertionError(f"the display path wrote {name!r}")
+
+
+def _cli(*, prompt=174_615, window=CONFIGURED, compressions=2, frozen=False):
+    cli = HermesCLI.__new__(HermesCLI)
+    cli.model = "opus-4.7"
+    cli.session_start = datetime.now() - timedelta(hours=12, minutes=21)
+    cli.conversation_history = []
+    cli.config = {"delegation": {"model": "qwen38-27b-agent",
+                                 "base_url": "http://127.0.0.1:30001/v1"}}
+    cli._status_bar_visible = True
+    cli._status_bar_suppressed_after_resize = False
+    cli._model_picker_state = None
+    cli._prompt_start_time = None
+    cli._prompt_duration = 83.0
+    cli._last_turn_finished_at = None
+    cli._battery_visible = False
+    cli._focus_view_enabled = False
+    cli._prompt_stash = SimpleNamespace(indicator=lambda: "")
+    cli._background_tasks = {}
+    fields = dict(last_prompt_tokens=prompt, context_length=window,
+                  compression_count=compressions, max_tokens=MAIN_MT,
+                  _base_threshold_percent=ARCHITECT_PCT)
+    compressor = _FrozenCompressor(**fields) if frozen else SimpleNamespace(**fields)
+    cli.agent = SimpleNamespace(
+        model="opus-4.7", provider=None, base_url="http://127.0.0.1:30001/v1",
+        session_input_tokens=0, session_output_tokens=0,
+        session_cache_read_tokens=0, session_cache_write_tokens=0,
+        session_prompt_tokens=0, session_completion_tokens=0,
+        session_total_tokens=0, session_api_calls=0,
+        context_compressor=compressor,
+    )
+    return cli
+
+
+def _sessions(grants):
+    return {
+        str(pid): {"main_window": g, "main_grow_max": g, "child_streams": 1,
+                   "child_window_max": 64_000, "child_grow_max": 73_728,
+                   "priority_main": 100, "priority_child": 0,
+                   "reason": f"rule-v1: {len(grants)} main(s), main cap {g:,}"}
+        for pid, g in grants.items()
+    }
+
+
+def _publish(grants, *, pool=LIVE_POOL, age_s=0.0):
+    """Write a broker document into the PER-TEST run dir.
+
+    ``tests/conftest.py``'s ``_isolate_gpu0_pool_and_overflow_state`` repoints
+    ``pool_broker``'s run dir at a tempdir and re-checks it before and after
+    every test, so this can never reach live production state.
+    """
+    path = pb._allowance_path()
+    path.parent.mkdir(parents=True, exist_ok=True)
+    doc = {"version": 3, "updated": time.time() - age_s, "pool": pool,
+           "ceiling": pool, "n_mains": len(grants), "main_window_floor": 64_000,
+           "policy": "rule-v1", "sessions": _sessions(grants)}
+    path.write_text(json.dumps(doc), encoding="utf-8")
+    ps.invalidate()
+    return path
+
+
+def _unpublish():
+    path = pb._allowance_path()
+    if path.exists():
+        path.unlink()
+    ps.invalidate()
+
+
+@pytest.fixture(autouse=True)
+def _clean_share_cache():
+    ps.invalidate()
+    yield
+    ps.invalidate()
+
+
+def _patches(width, *, lane=LANE, title=""):
+    return (
+        patch("hermes_cli.delegation_lane.get_lane_snapshot", return_value=lane),
+        patch("hermes_cli.delegation_lane.get_model_role", return_value="architect"),
+        patch.object(HermesCLI, "_get_tui_terminal_width",
+                     staticmethod(lambda *a, **k: width)),
+        patch.object(HermesCLI, "_is_session_yolo_active", lambda self: False),
+        patch.object(HermesCLI, "_get_goal_manager", lambda self: None),
+        patch.object(HermesCLI, "_get_status_bar_session_title", lambda self: title),
+        patch.object(HermesCLI, "_status_bar_output_tps", lambda self: "45.9 tok/s"),
+        patch.object(HermesCLI, "_status_bar_activity_fields", lambda self: []),
+    )
+
+
+def _rows(cli=None, *, width=WIDTH, lane=LANE, title="", **kw):
+    cli = cli if cli is not None else _cli(**kw)
+    started = _patches(width, lane=lane, title=title)
+    for p in started:
+        p.start()
+    try:
+        frags = cli._get_status_bar_fragments()
+    finally:
+        for p in reversed(started):
+            p.stop()
+    return "".join(text for _, text in frags).split("\n")
+
+
+def _fragments(cli=None, *, width=WIDTH, **kw):
+    cli = cli if cli is not None else _cli(**kw)
+    started = _patches(width)
+    for p in started:
+        p.start()
+    try:
+        return cli._get_status_bar_fragments()
+    finally:
+        for p in reversed(started):
+            p.stop()
+
+
+# ---------------------------------------------------------------------------
+# The denominator
+# ---------------------------------------------------------------------------
+
+class TestCtxDenominatorIsTheLiveShare:
+    def test_before__no_document_keeps_the_static_config(self):
+        """The pre-change bar, reproduced: no broker document, no sharing field,
+        the profile's configured window as the denominator."""
+        _unpublish()
+        row = _rows(prompt=174_615)[0]
+        assert "ctx 175K/393.2K" in row
+        assert "44%" in row
+        assert "⇄" not in row
+
+    def test_after__the_grant_becomes_the_denominator(self):
+        """A session whose prompt still fits under its share: the share IS what
+        it may occupy, so that is what the bar divides by."""
+        me = os.getpid()
+        _publish({me: 196_608, me + 1: 196_608})
+        row = _rows(prompt=40_000)[0]
+        assert "ctx 40K/196.6K" in row
+        assert "⇄ 2 mains · 451.3K pool" in row
+
+    def test_after__a_lone_main_shows_the_big_grant(self):
+        _publish({os.getpid(): 401_408})
+        row = _rows(prompt=40_000)[0]
+        assert "ctx 40K/401.4K" in row
+        assert "⇄ 1 main · 451.3K pool" in row
+
+    def test_the_percent_and_the_denominator_never_disagree(self):
+        """One row, one denominator. 40K against a 196,608 grant is 20%, not the
+        8% that 393,216 would have implied."""
+        me = os.getpid()
+        _publish({me: 196_608, me + 1: 196_608})
+        row = _rows(prompt=40_000)[0]
+        assert "ctx 40K/196.6K" in row and " 20%" in row
+
+    def test_a_pool_raised_to_13m_needs_no_edit_here(self):
+        """The host-RAM KV offload effort raises max_total_num_tokens; the bar
+        reads the live pool off the document and follows it."""
+        _publish({os.getpid(): 1_212_416}, pool=BIG_POOL)
+        row = _rows(prompt=40_000)[0]
+        assert "ctx 40K/1.2M" in row
+        assert "1.3M pool" in row
+
+
+# ---------------------------------------------------------------------------
+# It changes as peers come and go
+# ---------------------------------------------------------------------------
+
+class TestTracksPeers:
+    def test_the_denominator_follows_1_to_2_to_3_mains(self):
+        me = os.getpid()
+        seen = []
+        for grants in ({me: 401_408},
+                       {me: 196_608, me + 1: 196_608},
+                       {me: 131_072, me + 1: 131_072, me + 2: 131_072}):
+            _publish(grants)
+            row = _rows(prompt=40_000)[0]
+            seen.append(row.split("ctx ")[1].split(" ")[0])
+        assert seen == ["40K/401.4K", "40K/196.6K", "40K/131.1K"]
+
+    def test_the_peer_count_in_the_field_follows_too(self):
+        me = os.getpid()
+        _publish({me: 401_408})
+        assert "⇄ 1 main · 451.3K pool" in _rows(prompt=40_000)[0]
+        _publish({me: 131_072, me + 1: 131_072, me + 2: 131_072})
+        assert "⇄ 3 mains · 451.3K pool" in _rows(prompt=40_000)[0]
+
+    def test_a_peer_exiting_gives_the_room_back(self):
+        me = os.getpid()
+        _publish({me: 196_608, me + 1: 196_608})
+        assert "ctx 40K/196.6K" in _rows(prompt=40_000)[0]
+        _publish({me: 401_408})
+        assert "ctx 40K/401.4K" in _rows(prompt=40_000)[0]
+
+    def test_a_granted_loan_is_visible_on_both_sides(self):
+        """The asymmetric split the broker makes when one main is busy and the
+        other idle: 270,336 / 131,072, revocable."""
+        me, peer = os.getpid(), os.getpid() + 1
+        _publish({me: 270_336, peer: 131_072})
+        assert "+loan" in _rows(prompt=40_000, window=270_336)[0]
+        _publish({me: 131_072, peer: 270_336})
+        row = _rows(prompt=40_000, window=131_072)[0]
+        assert "-loan" in row and "ctx 40K/131.1K" in row
+
+    def test_a_revoked_loan_drops_the_marker(self):
+        me, peer = os.getpid(), os.getpid() + 1
+        _publish({me: 270_336, peer: 131_072})
+        assert "loan" in _rows(prompt=40_000, window=270_336)[0]
+        _publish({me: 196_608, peer: 196_608})
+        assert "loan" not in _rows(prompt=40_000, window=270_336)[0]
+
+
+# ---------------------------------------------------------------------------
+# Over-share
+# ---------------------------------------------------------------------------
+
+class TestOverShareRendersHonestly:
+    def test_the_held_window_stays_the_denominator_and_the_share_is_named(self):
+        """Andre's live session: grant 196,608, holding a 393,216 window with a
+        174,615-token prompt. Adopting the grant would force a compaction, so
+        the bar shows the window it really has AND the share it is above."""
+        me = os.getpid()
+        _publish({me: 196_608, me + 1: 196_608})
+        row = _rows(prompt=174_615)[0]
+        assert "ctx 175K/393.2K" in row
+        assert "⇄ 2 mains · 451.3K pool · share 196.6K ▲" in row
+
+    def test_the_gauge_does_not_peg_a_legitimately_over_share_session(self):
+        """Over-share is not "about to compact". Pegging the bar at 100% red
+        would read as an instruction to compact a session that is at 44% of the
