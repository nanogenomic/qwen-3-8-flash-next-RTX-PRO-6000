+# ---------------------------------------------------------------------------
+# ⛔ The display path may not touch the agent, the broker, or the GPU
+# ---------------------------------------------------------------------------
+
+class TestNoDisplayPathSideEffects:
+    def test_repainting_never_writes_the_compressor(self):
+        """The whole point. A bar repaint reads the broker's grant and renders
+        text; it must be structurally incapable of applying it to a live
+        session. _FrozenCompressor turns any write, and any call to a compaction
+        entry point, into a failure."""
+        me = os.getpid()
+        _publish({me: 196_608, me + 1: 196_608})
+        for prompt, window in ((40_000, CONFIGURED),      # adoptable grant
+                               (174_615, CONFIGURED),     # over share
+                               (300_000, CONFIGURED)):    # over trigger
+            cli = _cli(prompt=prompt, window=window, frozen=True)
+            for _ in range(25):                            # many repaints
+                _rows(cli)
+            assert cli.agent.context_compressor.context_length == window
+
+    def test_repainting_never_rewrites_the_broker_document(self):
+        me = os.getpid()
+        path = _publish({me: 196_608, me + 1: 196_608})
+        before = path.stat().st_mtime_ns
+        for _ in range(10):
+            _rows(prompt=174_615)
+        assert path.stat().st_mtime_ns == before
+
+    def test_repainting_never_publishes_a_heartbeat_or_a_growth_claim(self):
+        me = os.getpid()
+        _publish({me: 196_608, me + 1: 196_608})
+        for name in ("publish_heartbeat", "claim_growth", "refresh",
+                     "get_allowance", "_get_json"):
+            def _boom(*a, _n=name, **k):           # pragma: no cover
+                raise AssertionError(f"the display path called pool_broker.{_n}()")
+            patch.object(pb, name, _boom).start()
+        try:
+            rows = _rows(prompt=174_615)
+        finally:
+            patch.stopall()
+        assert "share 196.6K ▲" in rows[0]
+
+    def test_repainting_is_cheap_enough_for_the_repaint_timer(self):
+        """One stat() per repaint, one READ per broker rewrite. The bar repaints
+        on a timer, so re-reading and re-parsing the document every frame would
+        be a UI-thread cost paid many times a second — and a TTL cache would
+        instead make a freshly published grant invisible for the length of the
+        TTL, which is the behaviour this feature exists to provide."""
+        from pathlib import Path
+
+        me = os.getpid()
+        path = _publish({me: 196_608, me + 1: 196_608})
+        reads = {"n": 0}
+        real_read = Path.read_text
+
+        def counted(self, *a, **k):
+            if self == path:
+                reads["n"] += 1
+            return real_read(self, *a, **k)
+
+        with patch.object(Path, "read_text", counted):
+            for _ in range(20):
+                _rows(prompt=174_615)
+            assert reads["n"] == 1, reads          # 20 repaints, one read
+
+            _publish({me: 401_408})                # broker rewrites the document
+            rows = _rows(prompt=174_615)
+        assert reads["n"] == 2, reads
+        assert "1 main" in rows[0]
