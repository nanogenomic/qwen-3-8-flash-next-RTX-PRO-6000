+# ---------------------------------------------------------------------------
+# Degradation — every one of these has actually happened
+# ---------------------------------------------------------------------------
+
+class TestDegradesSafely:
+    def test_absent_document_falls_back_to_the_session_window(self):
+        v = _view(None)
+        assert not v["present"] and not v["usable"]
+        assert v["ceiling"] == CONFIGURED and v["ceiling_source"] == "window"
+        assert ps.share_segment(v) == ""
+
+    def test_empty_document_is_treated_as_absent(self):
+        assert ps.share_segment(_view({})) == ""
+
+    def test_a_stale_document_is_not_quoted_as_now(self):
+        """90 s, the same age pool_broker allows its serving-host VRAM sample. The
+        document is rewritten every ~5 s, so 90 s means the publisher is gone."""
+        v = _view(_doc({os.getpid(): 196_608}), age=120.0)
+        assert v["present"] and v["stale"] and not v["fresh"] and not v["usable"]
+        assert v["ceiling"] == CONFIGURED          # the static config, as before
+        assert ps.share_segment(v) == "⇄ pool stale 2m ⚠"
+        assert ps.segment_style(v) == "class:status-bar-bad"
+
+    def test_the_staleness_boundary_is_the_documented_one(self):
+        doc = _doc({os.getpid(): 196_608})
+        assert _view(doc, age=ps.DISPLAY_MAX_AGE_S)["fresh"] is True
+        assert _view(doc, age=ps.DISPLAY_MAX_AGE_S + 0.1)["fresh"] is False
+
+    def test_the_staleness_rule_is_the_codebases_existing_precedent(self):
+        """90 s, the age pool_broker already allows its serving-host VRAM sample. Pinned
+        so the two cannot silently diverge: "a sample this old is not evidence
+        about now" should mean one thing in this codebase."""
+        assert ps.DISPLAY_MAX_AGE_S == pb.VRAM_SAMPLE_MAX_AGE_S == 90.0
+
+    def test_a_document_with_no_timestamp_reads_as_stale(self):
+        doc = _doc({os.getpid(): 196_608})
+        doc.pop("updated")
+        v = ps.lane_share(doc, pid=os.getpid(), window=CONFIGURED,
+                          prompt_tokens=40_000, max_tokens=MAIN_MT,
+                          threshold_percent=ARCHITECT_PCT,
+                          age_s=time.time())          # what read_document computes
+        assert v["stale"] and not v["usable"] and v["ceiling"] == CONFIGURED
+
+    def test_an_old_peer_publishing_unbounded_ceilings_is_refused(self):
+        """Andre's two sessions published exactly this until 301b96a landed:
+        main_window == main_grow_max == the whole pool, for BOTH mains. Two
+        grants of 451,264 on a 451,264 pool is not a share -- quoting it as one
+        would be a worse lie than the static config was."""
