+# ---------------------------------------------------------------------------
+# Driven by the REAL broker policy, not by hand-written grants
+# ---------------------------------------------------------------------------
+
+#: Geometries taken from the live host: ``need`` is the UNSCALED measured demand
+#: ``pool_broker`` collects per main (pid 900003 at 199,191 and pid 900004 at
+#: 258,700 on 2026-09-30), plus the asymmetric pair that produces a loan — one
+#: main busy at a 433,782-token prompt beside an idle one at 40,000.
+REAL_NEEDS = {
+    "one main": [199_191],
+    "two mains": [199_191, 258_700],
+    "three mains": [199_191, 258_700, 60_000],
+    "busy beside idle": [433_782, 40_000],
+}
