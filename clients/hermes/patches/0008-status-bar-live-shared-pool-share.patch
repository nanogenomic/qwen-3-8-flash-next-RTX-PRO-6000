+# Copyright © 2026 Ligandal, Inc. All rights reserved.
+"""The status bar's view of the SHARED GPU0 KV pool. [bd-dre-hxxze]
+
+Measured symptom this covers: two architect mains on one 451,264-token pool both
+rendered ``ctx …/393.2K`` — the static profile ``context_length`` — while the
+broker was granting each of them 196,608.  786,432 tokens of claimed window
+against a 451,264-token pool, and nothing on the bar said they were sharing it.
+
+``hermes_cli.pool_share`` is the reader that closes that gap.  It is DISPLAY
+ONLY: it never writes the broker document, never probes the backend, never calls
+``pool_broker.get_allowance()`` (which may refresh over the network), and cannot
+shrink a live session or trigger a compaction.  These tests pin the three things
+that have to hold for that to stay true and useful:
+
+* the ceiling it reports follows the LIVE grant as peers come and go;
+* every degraded document — absent, stale, or written by a pre-301b96a peer that
+  still publishes unbounded ceilings — falls back to the session's own window
+  rather than quoting a number that is not a share; and
+* the pool total is read from the document, so raising the pool (the ~1.31M
+  host-RAM KV offload effort) needs no edit here.
+
+Production state is unreachable: ``tests/conftest.py``'s
+``_isolate_gpu0_pool_and_overflow_state`` repoints ``pool_broker``'s run dir at a
+per-test tempdir and re-checks it before and after every test, and this module
+resolves the document only through ``pool_broker._allowance_path()`` so it lands
+inside that isolation rather than beside it.
+"""
+
+import json
+import os
+import time
+
+import pytest
+
+import agent.pool_broker as pb
+from hermes_cli import pool_share as ps
+
+LIVE_POOL = 451_264          # the pool measured on this host, 2026-09-30
+BIG_POOL = 1_310_720         # the host-RAM KV offload target
+MAIN_MT = 8_192              # architect max_tokens
+ARCHITECT_PCT = 0.85         # architect compression.threshold since 2026-09-29
+CONFIGURED = 393_216         # profiles/architect context_length
+
+
+def _sessions(grants):
+    return {
+        str(pid): {
+            "main_window": g,
+            "main_grow_max": g,
+            "child_streams": 1,
+            "child_window_max": 64_000,
+            "child_grow_max": 73_728,
+            "priority_main": 100,
+            "priority_child": 0,
+            "reason": f"rule-v1: {len(grants)} main(s) sharing the pool, main cap {g:,}",
+        }
+        for pid, g in grants.items()
+    }
+
+
+def _doc(grants, *, pool=LIVE_POOL, updated=None, version=3):
+    """A document shaped exactly like the one the broker publishes."""
+    return {
+        "version": version,
+        "updated": time.time() if updated is None else updated,
+        "backend": "http://127.0.0.1:30001",
+        "policy": "rule-v1",
+        "pool": pool,
+        "ceiling": pool,
+        "n_mains": len(grants),
+        "main_window_floor": 64_000,
+        "sessions": _sessions(grants),
+    }
+
+
+def _view(doc, *, pid=None, window=CONFIGURED, prompt=40_000, age=0.0):
+    return ps.lane_share(
+        doc, pid=pid if pid is not None else os.getpid(), window=window,
+        prompt_tokens=prompt, max_tokens=MAIN_MT,
+        threshold_percent=ARCHITECT_PCT, age_s=age,
+    )
+
+
+@pytest.fixture(autouse=True)
+def _fresh_cache():
+    ps.invalidate()
+    yield
+    ps.invalidate()
+
+
+# ---------------------------------------------------------------------------
+# The live grant is the ceiling
+# ---------------------------------------------------------------------------
+
+class TestCeilingFollowsTheGrant:
+    def test_a_lone_main_gets_the_big_grant(self):
+        v = _view(_doc({os.getpid(): 401_408}))
+        assert (v["ceiling"], v["ceiling_source"]) == (401_408, "grant")
+        assert v["usable"] and v["bounded"] and not v["over_share"]
+        assert v["n_mains"] == 1 and v["peers"] == 0
+
+    def test_the_ceiling_halves_when_a_peer_main_launches(self):
+        """1 -> 2 -> 3 mains. The denominator is the share, so it moves."""
+        me = os.getpid()
+        seen = []
+        for grants in (
+            {me: 401_408},
+            {me: 196_608, me + 1: 196_608},
+            {me: 131_072, me + 1: 131_072, me + 2: 131_072},
+        ):
+            v = _view(_doc(grants))
+            seen.append((v["n_mains"], v["ceiling"]))
+        assert seen == [(1, 401_408), (2, 196_608), (3, 131_072)]
+
+    def test_the_ceiling_recovers_when_the_peer_exits(self):
+        me = os.getpid()
+        assert _view(_doc({me: 196_608, me + 1: 196_608}))["ceiling"] == 196_608
+        assert _view(_doc({me: 401_408}))["ceiling"] == 401_408
+
+    def test_a_grant_above_the_running_window_is_headroom(self):
+        """Grant >= window: the compressor will grow into it, so it IS the ceiling."""
+        v = _view(_doc({os.getpid(): 401_408}), window=196_608, prompt=100_000)
+        assert (v["ceiling"], v["ceiling_source"]) == (401_408, "grant")
+        assert not v["over_share"]
+
+    def test_the_pool_total_is_read_not_compiled_in(self):
+        """A ~1.31M pool needs no edit here -- the number comes off the document."""
+        v = _view(_doc({os.getpid(): 1_212_416}, pool=BIG_POOL), window=CONFIGURED,
+                  prompt=40_000)
+        assert v["pool"] == BIG_POOL
+        assert (v["ceiling"], v["ceiling_source"]) == (1_212_416, "grant")
+        assert "1.3M pool" in ps.share_segment(v)
+
+    def test_grow_max_below_window_still_reports_the_granted_window(self):
+        """``main_grow_max < main_window`` is "hold what you have, stop growing" --
+        a growth stop, not a statement that the granted window is unusable."""
+        doc = _doc({os.getpid(): 262_144})
+        doc["sessions"][str(os.getpid())]["main_grow_max"] = 196_608
+        v = _view(doc, window=196_608, prompt=40_000)
+        assert v["grant"] == 262_144
+
+
+# ---------------------------------------------------------------------------
+# Over-share is a real state, not an error
+# ---------------------------------------------------------------------------
+
+class TestOverShare:
+    def test_a_grandfathered_session_keeps_the_window_it_holds(self):
+        """The live case, 2026-09-30: grant 196,608, window 393,216, prompt
+        174,615.  footprint(196,608) = 160,153 < 174,615, so adopting the grant
+        would force a compaction the broker did not ask for.  Andre: a live
+        session's context is his call.  So the CEILING stays the held window and
+        the share is reported alongside it."""
+        v = _view(_doc({os.getpid(): 196_608, os.getpid() + 1: 196_608}),
+                  window=393_216, prompt=174_615)
+        assert (v["ceiling"], v["ceiling_source"]) == (393_216, "window")
+        assert v["over_share"] and v["grant"] == 196_608
+        assert v["over_tokens"] == 393_216 - 196_608
+        seg = ps.share_segment(v)
+        assert "share 196.6K ▲" in seg and "2 mains" in seg and "451.3K pool" in seg
+
+    def test_the_same_grant_is_adopted_while_the_prompt_still_fits(self):
+        """Same geometry, smaller prompt: the grant's trigger is still above it,
+        so settling onto the share compacts nothing and the share IS the ceiling.
+        This is the exact test ContextCompressor._maybe_pool_adopt_share applies."""
+        trigger = pb.footprint(196_608, MAIN_MT, ARCHITECT_PCT)
+        v = _view(_doc({os.getpid(): 196_608, os.getpid() + 1: 196_608}),
+                  window=393_216, prompt=trigger - 1)
+        assert (v["ceiling"], v["ceiling_source"]) == (196_608, "grant")
+        assert not v["over_share"]
+        assert "▲" not in ps.share_segment(v)
+
+    def test_over_share_never_asks_for_anything_to_shrink(self):
+        """The view is data. Nothing in it is a window to apply, and the only
+        ceiling it reports for an over-share session is the one already held."""
+        v = _view(_doc({os.getpid(): 131_072, os.getpid() + 1: 131_072,
+                        os.getpid() + 2: 131_072}),
+                  window=393_216, prompt=300_000)
+        assert v["ceiling"] == 393_216 >= v["grant"]
+
