+        assert styles == {"class:status-bar-bad"}
+
+    def test_an_ordinary_share_stays_dim(self):
+        me = os.getpid()
+        _publish({me: 196_608, me + 1: 196_608})
+        styles = {style for style, text in _fragments(prompt=40_000)
+                  if text.startswith("⇄")}
+        assert styles == {"class:status-bar-dim"}
+
+
+# ---------------------------------------------------------------------------
+# Degradation
+# ---------------------------------------------------------------------------
+
+class TestDegradesSafely:
+    def test_no_document_renders_the_pre_change_bar(self):
+        _unpublish()
+        rows = _rows(prompt=174_615)
+        assert "ctx 175K/393.2K" in rows[0] and "⇄" not in rows[0]
+        assert len(rows) == 2                      # the delegation lane is intact
+
+    def test_a_stale_document_falls_back_and_says_so(self):
+        me = os.getpid()
+        _publish({me: 196_608, me + 1: 196_608}, age_s=300.0)
+        row = _rows(prompt=40_000)[0]
+        assert "ctx 40K/393.2K" in row              # the static config, as before
+        assert "⇄ pool stale 5m ⚠" in row
+
+    def test_an_unbounded_document_from_an_old_peer_falls_back(self):
+        """Andre's sessions published main_window == main_grow_max == the whole
+        pool for BOTH mains until 301b96a. Two grants of 451,264 on a 451,264
+        pool is not a share, so it is refused as the denominator and named."""
+        me = os.getpid()
+        _publish({me: LIVE_POOL, me + 1: LIVE_POOL})
+        row = _rows(prompt=40_000)[0]
+        assert "ctx 40K/393.2K" in row
+        assert "no share cap ⚠" in row
+
+    def test_a_truncated_document_cannot_take_the_bar_down(self):
+        path = pb._allowance_path()
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text('{"version": 3, "sessions": {', encoding="utf-8")
+        ps.invalidate()
+        rows = _rows(prompt=174_615)
+        assert "ctx 175K/393.2K" in rows[0] and "⇄" not in rows[0]
+
+    def test_an_unreadable_document_cannot_take_the_bar_down(self):
+        _publish({os.getpid(): 196_608})
+        with patch.object(ps, "read_document",
+                          side_effect=OSError("permission denied")):
+            rows = _rows(prompt=174_615)
+        assert "ctx 175K/393.2K" in rows[0]
+
+    def test_a_process_that_is_not_a_main_gets_no_share_field(self):
+        _publish({os.getpid() + 9: 401_408})
+        row = _rows(prompt=40_000)[0]
+        assert "ctx 40K/393.2K" in row and "⇄" not in row
+
+    def test_a_session_with_no_window_yet_shows_the_grant(self):
+        """Before the first response the compressor can report no window. The
+        grant is then the only thing known about what this lane may occupy, so
+        it is what the bar shows."""
+        _publish({os.getpid(): 196_608})
+        assert "ctx 0/196.6K" in _rows(_cli(prompt=0, window=0))[0]
+
