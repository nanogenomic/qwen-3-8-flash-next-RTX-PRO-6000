+def _derive(needs, pool=LIVE_POOL):
+    """Per-pid grants from ``pool_broker.derive_window_ceilings`` itself.
+
+    Pure arithmetic in the broker — no I/O, no globals beyond the geometry
+    constants — so the display can be driven by the real policy rather than by
+    grants a test author made up. THIS pid is always the first main.
+    """
+    usable = pool - int(pool * pb.CACHE_RESERVE_FRAC)
+    pids = [os.getpid()] + [os.getpid() + 1 + i for i in range(len(needs) - 1)]
+    mains = [{"pid": p, "max_tokens": MAIN_MT, "need": n}
+             for p, n in zip(pids, needs)]
+    caps, _child, detail = pb.derive_window_ceilings(
+        usable, mains, 1, pb.CHILD_MAX_TOKENS_DEFAULT, ARCHITECT_PCT, pool)
+    assert detail["feasible"], detail
+    return caps
+
+
+class TestAgainstTheRealBrokerPolicy:
+    def test_the_measured_451k_splits_reach_the_bar(self):
+        """The four splits the broker actually produces on this host's pool."""
+        expected = {
+            "one main": "401.4K",
+            "two mains": "196.6K",
+            "three mains": "131.1K",
+            "busy beside idle": "270.3K",
+        }
+        for label, needs in REAL_NEEDS.items():
+            _publish(_derive(needs))
+            row = _rows(prompt=40_000)[0]
+            assert f"ctx 40K/{expected[label]}" in row, (label, row)
+            n = len(needs)
+            assert f"⇄ {n} main{'' if n == 1 else 's'} · 451.3K pool" in row, label
+
+    def test_the_lane_guarantee_is_what_three_mains_see(self):
+        """GUARANTEED_LANE_WINDOW is also the equal share at three mains, which
+        is the largest N this pool can host at a usable window."""
+        caps = _derive(REAL_NEEDS["three mains"])
+        assert set(caps.values()) == {pb.GUARANTEED_LANE_WINDOW}
+        _publish(caps)
+        assert "ctx 40K/131.1K" in _rows(prompt=40_000)[0]
+
+    def test_the_loan_the_broker_actually_grants_is_labelled(self):
+        caps = _derive(REAL_NEEDS["busy beside idle"])
+        assert sorted(caps.values()) == [131_072, 270_336]
+        _publish(caps)
+        assert "+loan" in _rows(prompt=40_000, window=270_336)[0]
+
+    def test_a_13m_pool_adapts_with_no_edit_to_the_display(self):
+        """The host-RAM KV offload effort raises max_total_num_tokens. Every
+        number the bar shows is read from the document, so nothing here changes:
+        the same policy at 1,310,720 simply grants more."""
+        caps = _derive(REAL_NEEDS["two mains"], pool=BIG_POOL)
+        mine = caps[os.getpid()]
+        assert mine > 512_000, caps            # far above anything hard-coded
+        _publish(caps, pool=BIG_POOL)
+        row = _rows(prompt=40_000)[0]
+        assert f"/{_compact(mine)}" in row
+        assert "⇄ 2 mains · 1.3M pool" in row
+
+    def test_a_lone_main_granted_the_whole_pool_is_not_read_as_unbounded(self):
+        """At 1,310,720 the real policy hands a lone main the entire pool. One
+        main cannot starve anyone, so grants that SUM to the ceiling are a
+        legitimate split -- only a sum ABOVE it is the pre-301b96a bug."""
+        caps = _derive(REAL_NEEDS["one main"], pool=BIG_POOL)
+        assert caps[os.getpid()] == BIG_POOL
+        _publish(caps, pool=BIG_POOL)
+        row = _rows(prompt=40_000)[0]
+        assert "ctx 40K/1.3M" in row and "no share cap" not in row
+
+
+def _compact(tokens):
+    from hermes_cli.banner import _format_context_length
+
+    return _format_context_length(tokens)
