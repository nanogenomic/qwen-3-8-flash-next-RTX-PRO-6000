+        try:
+            con = _connect_ro(db)
+        except Exception as exc:
+            LOG.warning("skip %s (%s): cannot open state.db: %s", profile, db, exc)
+            continue
+        try:
+            rows = con.execute(
+                "SELECT key, value FROM state_meta WHERE key LIKE 'goal:%'"
+            ).fetchall()
+        except Exception as exc:
+            LOG.warning("skip %s: state_meta read failed: %s", profile, exc)
+            continue
+        finally:
+            try:
+                con.close()
+            except Exception:
+                pass
+        for key, value in rows:
+            session_id = str(key)[len("goal:"):]
+            try:
+                data = json.loads(value)
+            except Exception:
+                continue
+            if not isinstance(data, dict) or data.get("status") != "active":
+                continue
+            label = f"{profile}/{session_id}"
+
+            turns_used = _as_float(data.get("turns_used"))
+            max_turns = _as_float(data.get("max_turns"))
