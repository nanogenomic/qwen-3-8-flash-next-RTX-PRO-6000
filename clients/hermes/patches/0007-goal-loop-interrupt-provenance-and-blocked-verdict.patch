+# ⛔ THE MARKER FOR A PAUSE THAT NEEDS A HUMAN DECISION [bd-dre-df78a].
+#
+# A `blocked` verdict means the WHOLE goal is gated on something only a person
+# can supply — a login, an approval, a spend decision. It is emphatically NOT
+# auto-resumable (retrying cannot produce a credential), and it is NOT `done`
+# either: the work is unfinished. Before this marker existed the judge was
+# instructed to report exactly this case as DONE, which ended goals with a "✓
+# Goal achieved" over work that had not happened.
+BLOCKED_PAUSE_MARKER = "goal-blocked-needs-human-decision"
+
+
+def blocked_paused_reason(reason: str) -> str:
+    """The ``paused_reason`` for a needs-a-human pause, marker first."""
+    return f"{BLOCKED_PAUSE_MARKER}: {reason}"
