+    cli, mgr = _cli_with_loop(f"loop-human-{uuid.uuid4().hex}")
+    cli._last_turn_interrupted = True
+    cli._human_interrupt_requested = True
+    with patch.object(cli, "_get_loop_manager", return_value=mgr):
+        cli._maybe_complete_loop_tick_after_turn()
+    assert mgr.state.status == "paused"
+
+
+def test_machine_interrupt_keeps_the_loop_armed(hermes_home):
+    cli, mgr = _cli_with_loop(f"loop-machine-{uuid.uuid4().hex}")
+    cli._last_turn_interrupted = True
+    cli._human_interrupt_requested = False
