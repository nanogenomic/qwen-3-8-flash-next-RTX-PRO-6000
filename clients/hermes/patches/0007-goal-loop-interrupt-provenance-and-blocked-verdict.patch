+
+import queue
+import uuid
+from pathlib import Path
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+
+@pytest.fixture
+def hermes_home(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    yield home
+
+
+def _cli_with_loop(sid: str):
+    from cli import HermesCLI
+    from hermes_cli.loops import LoopManager, save_loop
+
+    cli = HermesCLI.__new__(HermesCLI)
+    cli._pending_input = queue.Queue()
+    cli._last_turn_interrupted = False
+    cli._human_interrupt_requested = False
+    cli.conversation_history = []
+    cli.session_id = sid
+    cli.agent = MagicMock()
+    cli.agent.session_id = sid
+
+    mgr = LoopManager(session_id=sid)
+    mgr.set("check the deploy", interval_seconds=300)
+    # Put the loop in the state fire_tick() leaves behind: a wakeup turn is
+    # out and the post-turn hook is what completes it. Set directly rather than
+    # calling fire_tick(), which no-ops until the interval is actually due.
+    mgr.state.awaiting_response = True
+    save_loop(sid, mgr.state)
+    assert mgr.state.awaiting_response is True
+    cli._loop_manager = mgr
+    return cli, mgr
+
+
