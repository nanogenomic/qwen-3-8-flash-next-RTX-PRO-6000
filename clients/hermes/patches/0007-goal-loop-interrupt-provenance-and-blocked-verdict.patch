+    def _kick_goal_after_resume(self, mgr) -> bool:
+        """Queue the first continuation turn for a just-resumed goal.
+
+        Returns True when a continuation was enqueued. See the call site in
+        ``/goal resume`` for why this is needed [bd-dre-df78a]: resume flips the
+        status, but only a POST-TURN hook enqueues continuations, and a slash
+        command never runs a turn — so without this the goal is "active" and
+        idle, which is the stall the resume was meant to end.
+
+        Never raises: a failure here degrades to the old "type continue"
+        behavior rather than breaking the command.
+        """
+        pending = getattr(self, "_pending_input", None)
+        if pending is None:
+            return False
+        try:
+            # Don't stack a continuation on top of work already queued — the
+            # user's own message goes first, and the post-turn hook will pick
+            # the goal up from there.
+            if not pending.empty():
+                return False
+            prompt = mgr.next_continuation_prompt()
+            if not prompt:
+                return False
+            try:
+                from cli import _AutonomousPrompt
+
+                payload = _AutonomousPrompt(prompt, "goal")
+            except Exception:
+                payload = prompt
+            pending.put(payload)
+            return True
+        except Exception as exc:
+            import logging
+
+            logging.debug("goal resume kick failed: %s", exc)
+            return False
+
     def _handle_goal_command(self, cmd: str) -> None:
         """Dispatch /goal subcommands: set / draft / show / gate / status / pause / resume / clear."""
         from cli import _DIM, _RST, _cprint
@@ -2765,10 +2803,30 @@ class CLICommandsMixin:
                 _cprint(f"  {_DIM}No goal to resume.{_RST}")
             else:
                 _cprint(f"  ▶ Goal resumed: {state.goal}")
-                _cprint(
-                    f"  {_DIM}Send any message (or press Enter on an empty prompt "
-                    f"is a no-op; type 'continue' to kick it off).{_RST}"
-                )
+                # ⛔ RESUME MUST ACTUALLY RE-ARM THE LOOP [bd-dre-df78a].
+                #
+                # `mgr.resume()` only flips status to active. The continuation
+                # is enqueued by `_maybe_continue_goal_after_turn`, which runs
+                # POST-TURN — and a slash command is dispatched through
+                # process_command, which never runs a turn. So `/goal resume`
+                # used to leave the goal "active" with nothing queued, and the
+                # pane sat idle until a human typed something.
+                #
+                # That made hermes-goal-resume-supervisor a no-op backstop: it
+                # correctly found the paused goal, correctly waited for an idle
