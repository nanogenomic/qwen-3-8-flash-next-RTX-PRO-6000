+    def test_the_watcher_has_a_hard_wall_clock_ceiling(self, hermes_home):
+        """A job that never finishes must not yield a watcher that never exits."""
+        from hermes_cli import goal_watchers
+
+        clock = {"t": 1000.0}
+        result = goal_watchers.run_watch_loop(
+            session_id=None, pid=None, until=clock["t"] + 10 ** 9,
+            since=clock["t"], reason="an endless job", goal_text="g",
+            poll_seconds=5.0, max_seconds=60.0,
+            sleep_fn=lambda s: clock.__setitem__("t", clock["t"] + s),
+            now_fn=lambda: clock["t"],
+        )
+        assert result["released"] is False
+        assert "STILL" in result["summary"]
+        assert clock["t"] - 1000.0 <= 60.0 + 5.0
