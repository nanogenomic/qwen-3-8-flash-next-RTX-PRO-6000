+    def test_the_goal_does_not_go_idle_when_other_work_exists(
+        self, hermes_home, dispatched
+    ):
+        """⛔ THE REGRESSION TEST FOR ANDRE'S PANE.
+
+            ⏳ Goal parked — waiting on session proc_0a1b2c3d4e5f: The goal is
+               not complete because the final v8 cut and the ranking pass
+               depend on the running index_pass2 job…
+            ↻ Loop: next in 30m.
+
+        Same goal, same judge verdict, same turn report. The goal must NOT be
+        parked and must NOT be idle: a continuation has to be queued.
+        """
+        mgr = _mgr()
+        decision = _drive(mgr, probe=self.PROBE_WITH_WORK)
+
+        assert decision["should_continue"] is True, (
+            "one long-running job must not take the whole goal off the road "
+            "while other work is open — that is 30 minutes of idle per tick"
+        )
+        assert decision["continuation_prompt"], "idle means no continuation queued"
+        assert decision["verdict"] == "defer"
+        assert decision["status"] == "active"
+
+        # No whole-goal barrier: nothing can quiesce the loop.
+        assert mgr.state.waiting_on_session is None
+        assert mgr.state.waiting_on_pid is None
+        assert not mgr.state.waiting_until
+        with _running_job():
+            assert mgr.is_waiting() is False
+
+            # The wait is recorded as an ITEM barrier instead, so the agent knows
+            # what is off-limits without the goal stopping.
+            items = mgr.active_blocked_items()
+            assert len(items) == 1
+            assert items[0].session_id == MEASURED_BARRIER_SESSION
