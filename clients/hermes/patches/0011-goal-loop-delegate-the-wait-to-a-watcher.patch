+        call = dispatched[0]
+        assert call["toolsets"] == []
+        assert call["model"] is None
+        assert call["role"] == "goal_wait_watcher"
+
+    def test_the_dispatch_arms_no_stale_monitor(self, hermes_home, dispatched):
+        """⛔ The stale monitor marks a delegation stuck on a FROZEN progress
+        token, and a watcher's token is frozen by design because it makes no api
+        calls. Passing one would get every watcher killed as stalled."""
+        mgr = _mgr()
+        _drive(mgr, probe={"items": []})
+        assert dispatched[0].get("progress_fn") is None
+
+    def test_the_watcher_runs_at_child_priority_not_control_plane(self, hermes_home):
+        """The goal judge stays at 100. A watcher is a child: PRIORITY_NORMAL.
+        Promoting one would re-create the starvation the broker warns about."""
+        from agent import pool_broker
+        from agent.delegation_context import delegated_child_context
+
+        with delegated_child_context():
+            assert pool_broker.current_priority() == pool_broker.PRIORITY_NORMAL
+        assert pool_broker.PRIORITY_CONTROL_PLANE == 100
+        assert pool_broker.PRIORITY_NORMAL < pool_broker.PRIORITY_CONTROL_PLANE
