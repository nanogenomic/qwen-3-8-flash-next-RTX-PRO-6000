+    def test_the_watcher_body_enters_the_child_context(self, hermes_home, dispatched):
+        """So that any incidental GPU0 call from a watcher is tagged as a child
+        rather than inheriting the parent's interactive 100."""
+        from agent import pool_broker
+        from hermes_cli import goal_watchers
+
+        seen = {}
+        monkey_loop = lambda **kw: (                      # noqa: E731
+            seen.setdefault("priority", pool_broker.current_priority()),
+            {"status": "completed", "summary": "", "api_calls": 0,
+             "duration_seconds": 0.0},
+        )[1]
+        with patch.object(goal_watchers, "run_watch_loop", monkey_loop):
+            mgr = _mgr()
+            _drive(mgr, probe={"items": []})
+            dispatched[0]["runner"]()
