+def _drive(mgr, *, probe, response=MEASURED_RESPONSE, directive=None,
+           verdict="wait", reason=MEASURED_WAIT_REASON, background=None):
+    """Run the REAL ``evaluate_after_turn`` with only the two network calls stubbed.
+
+    ``judge_goal`` is the judge boundary; ``agent.auxiliary_client.call_llm`` is
+    the probe boundary. Everything between them — the parse, the quote
+    verification, the barrier bookkeeping, the watcher dispatch — is production
+    code.
+    """
+    import agent.auxiliary_client as aux
+
+    if directive is None:
+        directive = {"session_id": MEASURED_BARRIER_SESSION}
+    # ⛔ process_registry persists NOTHING, so in a test an unknown session id
+    # reads as "not waiting" and the barrier would auto-clear before any
+    # assertion could see it. Every test here premises a job that is STILL
+    # RUNNING, which is what this patch states.
+    with patch("hermes_cli.goals._session_waiting", return_value=True), patch(
+        "hermes_cli.goals.judge_goal",
+        return_value=(verdict, reason, False, directive, False),
+    ), patch.object(aux, "call_llm", lambda **kw: _aux_reply(probe)):
+        return mgr.evaluate_after_turn(
+            response, user_initiated=True, background_processes=background,
+        )
+
