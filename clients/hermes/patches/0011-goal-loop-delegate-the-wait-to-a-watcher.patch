+# Copyright © 2026 Ligandal, Inc. All rights reserved.
+"""A goal delegates the wait; it does not park itself on it [bd-dre-n0vpl.4].
+
+⛔ THE PROBLEM THIS EXISTS FOR. Andre, 2026-09-30, watching it happen:
+*"you shouldn't park your goals; you should have subagents processing their own
+goals so you can continue grinding while waiting"* and *"problem is it parks
+goals rather than assigning goals/loops to subagents, while keeping itself as
+active as possible, too."*
+
+The park below is VERBATIM from his pane, and the state record behind it was read
+live out of ``~/.hermes/profiles/architect/state.db`` at 19:20 ET:
+
+    goal:20260929_125951_bbbbbb
+      status=active  turns=1/400  last_verdict=wait
+      waiting_on_session=proc_0a1b2c3d4e5f   age=1131s
+      subgoals=0     blocked_on=0
+
+399 turns unspent, on a turn whose own report named GPU packing work, queued rows
+and an ACK'd workflow split with a peer session.
+
+This is the third shape of "a goal loop that stops when it should continue",
+after the interrupt-provenance and false-``done`` defects in 6a428aa / 92dff5f.
+It must COMPOSE with those, so the tests here also assert what must NOT change:
+a park with nothing else to advance is still correct and still happens, a human's
+``/goal wait`` is not second-guessed, and no path may spawn unbounded watchers.
+"""
+
+from __future__ import annotations
+
+import json
+import time
+import uuid
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+
+# ──────────────────────────────────────────────────────────────────────
+# The measured park, verbatim
+# ──────────────────────────────────────────────────────────────────────
+
+#: The session id the goal was parked on.
+MEASURED_BARRIER_SESSION = "proc_0a1b2c3d4e5f"
+
+#: ``waiting_reason`` exactly as stored in the state record.
+MEASURED_WAIT_REASON = (
+    "The goal is not complete because the final v8 cut and ranking "
+    "scoring depend on the running index_pass2 job, which the agent is "
+    "waiting on."
+)
+
+MEASURED_GOAL = (
+    "Take the batch re-index campaign to a v8 cut: finish GPU packing "
+    "for the queued rows, keep the ACK'd workflow split with the peer session "
+    "moving, land the ranking pass once pass 2 lands, and write the final "
+    "v8 cut."
+)
+
+#: The shape of the turn report that preceded the park: productive, and naming
+#: work that has nothing to do with index_pass2.
+MEASURED_RESPONSE = (
+    "This turn: finished GPU packing for 14 of the queued rows and queued the "
+    "remaining 6. The ACK'd workflow split with the peer session is confirmed "
+    "on both sides. index_pass2 is still running as session "
+    f"{MEASURED_BARRIER_SESSION}, so the final v8 cut and ranking "
+    "scoring depend on it and I am waiting on that."
+)
+
+
+@pytest.fixture
+def hermes_home(tmp_path, monkeypatch):
+    """Isolated HERMES_HOME — these tests must never touch production state."""
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    from hermes_cli import goals
+
+    goals._DB_CACHE.clear()
+    yield home
+    goals._DB_CACHE.clear()
+
+
+def _function_code(name: str) -> str:
+    """CODE of one ``goal_watchers`` function — docstrings and comments stripped.
+
+    These source-shape assertions are about what the function CALLS. Scanning raw
+    text matched the docstring that explains which calls are forbidden, so the
+    test passed only while the prose was absent.
+    """
+    import ast
+    import io
+    import tokenize
+
+    from hermes_cli import goal_watchers as _gw
+
+    tree = ast.parse(Path(_gw.__file__).read_text(encoding="utf-8"))
+    for node in ast.walk(tree):
+        if isinstance(node, ast.FunctionDef) and node.name == name:
+            body = list(node.body)
+            if (body and isinstance(body[0], ast.Expr)
+                    and isinstance(body[0].value, ast.Constant)
+                    and isinstance(body[0].value.value, str)):
+                body = body[1:]      # drop the docstring
+            src = "\n".join(ast.unparse(stmt) for stmt in body)
+            # ast.unparse already drops comments; tokenize round-trip is belt and
+            # braces for any future string-literal weirdness.
+            return src
+    raise AssertionError(f"{name} not found in goal_watchers")
+
+
+def _running_job():
+    """Read barrier state under the same "the job is still running" premise."""
+    return patch("hermes_cli.goals._session_waiting", return_value=True)
+
+
+def _mgr(goal=MEASURED_GOAL, *, max_turns=400, subgoals=()):
+    from hermes_cli.goals import GoalManager
+
+    m = GoalManager(session_id=f"sid-{uuid.uuid4().hex}", default_max_turns=max_turns)
+    m.set(goal)
+    for s in subgoals:
+        m.add_subgoal(s)
+    return m
+
+
+def _aux_reply(payload) -> SimpleNamespace:
+    text = payload if isinstance(payload, str) else json.dumps(payload)
+    return SimpleNamespace(
+        choices=[SimpleNamespace(message=SimpleNamespace(content=text))]
+    )
+
+
+class _Dispatches(list):
+    """Records every ``dispatch_async_delegation`` call the watcher path makes."""
+
+    def __call__(self, **kwargs):
+        self.append(kwargs)
+        return {"status": "dispatched", "delegation_id": f"deleg_{len(self):08x}"}
+
+
+@pytest.fixture
+def dispatched(monkeypatch):
+    """Capture watcher dispatches instead of spawning real background threads."""
+    import tools.async_delegation as ad
+    from hermes_cli import goal_watchers
+    from gateway import session_context
+
+    calls = _Dispatches()
+    monkeypatch.setattr(ad, "dispatch_async_delegation", calls)
+    monkeypatch.setattr(goal_watchers, "_async_headroom", lambda: (True, ""))
+    monkeypatch.setattr(session_context, "async_delivery_supported", lambda: True)
+    return calls
