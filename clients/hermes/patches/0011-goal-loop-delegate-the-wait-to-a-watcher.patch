--- /dev/null
+++ b/hermes_cli/goal_watchers.py
@@ -0,0 +1,584 @@
+# Copyright © 2026 Ligandal, Inc. All rights reserved.
+"""Delegate the WAIT so the parent goal loop can keep grinding.
+
+⛔ THE PROBLEM THIS EXISTS FOR [bd-dre-n0vpl.4]. Andre, 2026-09-30, watching it
+happen: *"you shouldn't park your goals; you should have subagents processing
+their own goals so you can continue grinding while waiting"* and *"problem is it
+parks goals rather than assigning goals/loops to subagents, while keeping itself
+as active as possible, too."*
+
+The measured failure, from ``architect`` session ``20260929_125951_bbbbbb``
+(state record read live at 19:20 ET, barrier 1131 s old, turn 1 of 400):
+
+    ⏳ Goal parked — waiting on session proc_0a1b2c3d4e5f: The goal is not
+       complete because the final v8 cut and the ranking pass depend on the
+       running index_pass2 job, which the agent is waiting on.
+    ↻ Loop: next in 30m.
+
+One long-running job took the WHOLE goal off the road with 399 turns unspent,
+while the same turn's report named GPU packing work, queued rows and an ACK'd
+workflow split with a peer session.
+
+This module is the other half of the fix. ``hermes_cli.goals`` decides *whether*
+the park is right (see ``probe_advanceable_work``); this decides *who owns the
+wait* when it is. A watcher is dispatched onto the existing async-delegation rail
+and the parent goes back to work.
+
+WHAT A WATCHER IS, AND WHY IT IS THIS CHEAP
+-------------------------------------------
+A watcher makes **zero model calls**. It is a poll loop over the *same*
+release predicate the barrier itself uses — ``process_registry.is_session_waiting``
+for a session barrier, ``goals._barrier_pid_alive`` for a pid barrier, the
+deadline for a time barrier — and when that predicate flips it returns a bounded
+report of the job's outcome.
+
+That matters because GPU0's KV pool is shared with Andre's other main session,
+and a prior agent measured wasted prefill per call rising from 2,622 tokens with
+no contention to 114,385 with five other in-flight requests. A watcher that
+reasons about the job would pay that tax once per poll, forever, for a job whose
+completion is a boolean. So it does not reason:
+
+  * no ``call_llm``, no context window, no toolset, no tokens — nothing for the
+    broker's VRAM throttle or child-stream caps to throttle, because it never
+    opens a stream;
+  * it runs on the shared ``tools.daemon_pool`` executor the async-delegation
+    rail already owns, at ``PRIORITY_NORMAL`` — a delegated child's priority,
+    below the goal judge's control-plane 100, which is unchanged;
+  * ``progress_fn`` is deliberately NOT passed. The stale monitor marks a
+    delegation stuck on a frozen progress token, and a watcher's token is frozen
+    by design (it makes no api calls) — handing it one would get every watcher
+    killed as stalled. Its bound is its own ``WATCHER_MAX_SECONDS`` ceiling.
+
+The report re-enters the parent session through the rail's existing completion
+queue (``process_registry.completion_queue`` → the CLI/gateway idle drain), which
+forges a fresh turn. That turn runs the goal hook, which re-judges. So the
+watcher does not merely observe the release — **it is what wakes the goal up**,
+which is also why a correctly-parked goal is no longer a dead end.
+
+BOUNDS (no path may spawn unbounded watchers)
+---------------------------------------------
+  1. One watcher per (goal session, watch target). A goal re-parking on the same
+     job every turn refreshes nothing and spawns nothing.
+  2. At most ``max_wait_watchers`` (default 2) live watchers per goal.
+  3. A watcher is never dispatched into the LAST free async-delegation slot, so
+     watching can never starve the real subagents the parent needs in order to
+     keep grinding — which would defeat the entire point.
+  4. Every watcher has a hard wall-clock ceiling. A job that never finishes
+     yields a watcher that reports "still running after N s" and exits.
+"""
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Dict, List, Optional, Tuple
+
+logger = logging.getLogger(__name__)
+
+# How often a watcher re-tests its release predicate. The predicate is a cheap
+# in-process dict lookup (or a /proc stat), so this is about latency-to-wake, not
+# cost: 15 s means the parent learns a job finished within 15 s of it happening.
+DEFAULT_WATCHER_POLL_SECONDS = 15.0
+
+# Hard wall-clock ceiling on one watcher. Mirrors
+# ``goals.DEFAULT_ITEM_BARRIER_MAX_SECONDS`` — a watcher that could live forever
+# is the same defect as a barrier that can never release, one layer out. On
+# expiry it reports what it saw and exits, so the parent is told rather than left
+# guessing.
+DEFAULT_WATCHER_MAX_SECONDS = 3600.0
+
+# Live watchers per goal. Two is enough for the shape this exists for (a long
+# job plus a peer session), and small enough that watchers never dominate the
+# shared async-delegation pool.
+DEFAULT_MAX_WAIT_WATCHERS = 2
+
+#: Characters of the watched job's output carried back in the report.
+_OUTPUT_TAIL_CHARS = 1200
+
+#: Dispatch role, so ``/agents`` and the delegation ledger show what these are.
+WATCHER_ROLE = "goal_wait_watcher"
+
+
+# ─────────────────────────────────────────────────────────── config resolution
+
+
+def _goals_cfg(key: str, default: Any) -> Any:
+    """Read ``goals.<key>`` from config, degrading to *default*.
+
+    Reuses ``hermes_cli.goals._goals_config`` so watcher knobs live in the same
+    config block as every other goal-loop knob rather than a second namespace.
+    """
+    try:
+        from hermes_cli.goals import _goals_config
+
+        raw = (_goals_config() or {}).get(key)
+    except Exception:
+        return default
+    if raw is None:
+        return default
+    try:
+        if isinstance(default, bool):
+            return bool(raw)
+        if isinstance(default, int) and not isinstance(default, bool):
+            return int(raw)
+        if isinstance(default, float):
+            return float(raw)
+    except (TypeError, ValueError):
+        return default
+    return raw
+
+
+def watcher_poll_seconds() -> float:
+    value = _goals_cfg("watcher_poll_seconds", DEFAULT_WATCHER_POLL_SECONDS)
+    return max(1.0, float(value))
+
+
+def watcher_max_seconds() -> float:
+    value = _goals_cfg("watcher_max_seconds", DEFAULT_WATCHER_MAX_SECONDS)
+    return max(30.0, float(value))
+
+
+def max_wait_watchers() -> int:
+    value = _goals_cfg("max_wait_watchers", DEFAULT_MAX_WAIT_WATCHERS)
+    return max(0, int(value))
+
+
+# ───────────────────────────────────────────────────────────── the watch target
+
+
+def target_key(
+    *,
+    session_id: Optional[str] = None,
+    pid: Optional[int] = None,
+    until: Optional[float] = None,
+) -> str:
+    """Stable identity for one watch target, used for de-duplication.
+
+    Deliberately NOT derived from the reason text: the judge rewords its reason
+    every turn, so keying on it would spawn a fresh watcher per turn for the same
+    job — the unbounded-spawn failure this key exists to prevent.
+    """
+    if session_id:
+        return f"session:{session_id}"
+    if pid:
+        return f"pid:{int(pid)}"
+    if until:
+        # Bucket to the second: a deadline re-derived from ``until - now`` drifts
+        # by microseconds between turns and would otherwise look like a new
+        # target each time.
+        return f"deadline:{int(float(until))}"
+    return ""
+
+
+def describe_target(
+    *,
+    session_id: Optional[str] = None,
+    pid: Optional[int] = None,
+    until: Optional[float] = None,
+) -> str:
+    """Human-readable target, matching the goal loop's own park wording."""
+    if session_id:
+        return f"session {session_id}"
+    if pid:
+        return f"pid {int(pid)}"
+    if until:
+        remaining = max(0, int(float(until) - time.time()))
+        return f"{remaining}s"
+    return "an unnamed job"
+
+
+def barrier_released(
+    *,
+    session_id: Optional[str] = None,
+    pid: Optional[int] = None,
+    until: Optional[float] = None,
+    since: float = 0.0,
+    now_fn=time.time,
+) -> bool:
+    """True when this watch target's release condition has fired.
+
+    ⛔ Delegates to the EXACT predicates ``GoalManager.is_waiting`` uses, for the
+    same reason the resume supervisor imports ``goals.is_transport_pause``
+    instead of re-implementing it: a watcher and a barrier that disagree about
+    "finished" is worse than no watcher, because the parent would be told the job
+    is done while the loop stays parked.
+
+    Fail direction is "released" on any error — a watcher that cannot evaluate
+    its predicate reports back and lets the parent's own judge decide, rather
+    than sitting on a wait nobody can see.
+    """
+    try:
+        if session_id:
+            from hermes_cli.goals import _session_waiting
+
+            return not _session_waiting(session_id)
+        if pid:
+            from hermes_cli.goals import _barrier_pid_alive
+
+            return not _barrier_pid_alive(int(pid), since)
+        if until:
+            # ⛔ ``now_fn``, not ``time.time()`` — the watch loop and its release
+            # predicate must read ONE clock. Two clocks meant an injected clock
+            # released a deadline barrier instantly, and the ceiling could never
+            # be reached (caught by test_the_watcher_has_a_hard_wall_clock_ceiling).
+            return now_fn() >= float(until)
+    except Exception as exc:  # noqa: BLE001 - never wedge a watcher
+        logger.debug("goal watcher: release predicate failed (%s) — releasing", exc)
+        return True
+    return True
+
+
+def _outcome_snapshot(session_id: Optional[str], pid: Optional[int]) -> str:
+    """Bounded description of how the watched job ended.
+
+    ⛔ Reads ONLY ``list_sessions()``. ``process_registry.poll()`` /
+    ``read_log()`` mark a session poll-observed / completion-consumed, which
+    SUPPRESSES the registry's own ``[SYSTEM: ...]`` completion turn for that
+    process — so a watcher using them would silence the very notification the
+    parent may still need if this report fails to deliver. A watcher observes;
+    it does not consume.
+    """
+    if not session_id:
+        if pid:
+            return f"pid {int(pid)} is no longer running."
+        return ""
+    try:
+        from tools.process_registry import process_registry
+
+        for entry in process_registry.list_sessions() or []:
+            if not isinstance(entry, dict) or entry.get("session_id") != session_id:
+                continue
+            bits = [f"status={entry.get('status')}"]
+            if entry.get("exit_code") is not None:
+                bits.append(f"exit_code={entry.get('exit_code')}")
+            if entry.get("watch_hit"):
+                bits.append("watch_pattern=hit")
+            if entry.get("command"):
+                bits.append(f"command={str(entry['command'])[:160]}")
+            tail = str(entry.get("output_preview") or "")[-_OUTPUT_TAIL_CHARS:]
+            text = "  ".join(bits)
+            if tail.strip():
+                text = f"{text}\nOutput (tail):\n{tail}"
+            return text
+        return (
+            f"Session {session_id} is no longer in the process registry "
+            f"(it exited, or the registry was restarted)."
+        )
+    except Exception as exc:  # noqa: BLE001
+        logger.debug("goal watcher: outcome snapshot failed: %s", exc)
+        return f"Session {session_id} released; its outcome could not be read ({exc})."
+
+
+# ───────────────────────────────────────────────────────────── the watcher body
+
+
+def run_watch_loop(
+    *,
+    session_id: Optional[str],
+    pid: Optional[int],
+    until: Optional[float],
+    since: float,
+    reason: str,
+    goal_text: str,
+    poll_seconds: Optional[float] = None,
+    max_seconds: Optional[float] = None,
+    sleep_fn=time.sleep,
+    now_fn=time.time,
+) -> Dict[str, Any]:
+    """Own the wait. Return an async-delegation result dict.
+
+    Makes no model call and holds no context — see the module docstring. The
+    ``sleep_fn`` / ``now_fn`` seams exist so the tests can drive this
+    deterministically instead of sleeping.
+    """
+    poll = watcher_poll_seconds() if poll_seconds is None else max(0.0, float(poll_seconds))
+    ceiling = watcher_max_seconds() if max_seconds is None else max(0.0, float(max_seconds))
+    started = now_fn()
+    target = describe_target(session_id=session_id, pid=pid, until=until)
+    polls = 0
+
+    while True:
+        if barrier_released(session_id=session_id, pid=pid, until=until,
+                            since=since, now_fn=now_fn):
+            waited = round(now_fn() - started, 1)
+            outcome = _outcome_snapshot(session_id, pid)
+            summary = (
+                f"The job this goal was waiting on has finished: {target}.\n"
+                f"Waited {waited}s across {polls} check(s). "
+                f"Why the goal was waiting: {reason or '(no reason recorded)'}\n"
+            )
+            if outcome:
+                summary += f"\n{outcome}\n"
+            summary += (
+                "\nThe wait barrier on this goal is released. Pick the work that "
+                "depended on this job back up, verify its result before building "
+                "on it, and keep going."
+            )
+            return {
+                "status": "completed",
+                "summary": summary,
+                "error": None,
+                "api_calls": 0,
+                "duration_seconds": waited,
+                "released": True,
+                "polls": polls,
+            }
+
+        elapsed = now_fn() - started
+        if elapsed >= ceiling:
+            waited = round(elapsed, 1)
+            return {
+                "status": "completed",
+                "summary": (
+                    f"Stopped watching {target} after {waited}s — it is STILL "
+                    f"RUNNING and this watcher hit its {ceiling:.0f}s ceiling.\n"
+                    f"Why the goal was waiting: {reason or '(no reason recorded)'}\n\n"
+                    "Nothing is wrong with the job; nobody is watching it any "
+                    "more. Check it yourself this turn (one status line, no "
+                    "blocking poller), and if it still matters, get on with the "
+                    "rest of the goal while it runs."
+                ),
+                "error": None,
+                "api_calls": 0,
+                "duration_seconds": waited,
+                "released": False,
+                "polls": polls,
+            }
+
+        polls += 1
+        sleep_fn(min(poll, max(0.0, ceiling - elapsed)))
+
+
+# ──────────────────────────────────────────────────────────────────── dispatch
+
+
+def _async_headroom() -> Tuple[bool, str]:
+    """Whether there is a spare async-delegation slot BESIDES the last one.
+
+    ⛔ Bound 3. Watchers share ``delegation.max_concurrent_children`` with real
+    subagents. Letting a watcher take the final slot would mean the parent,
+    freshly un-parked and told to get on with other work, could not dispatch the
+    subagent it needs to do that work — trading one stall for another.
+    """
+    try:
+        from tools.async_delegation import active_count
+        from tools.delegate_tool import _get_max_async_children
+
+        cap = int(_get_max_async_children())
+        live = int(active_count())
+    except Exception as exc:  # noqa: BLE001
+        return False, f"async-delegation registry unavailable ({exc})"
+    if cap <= 1:
+        return False, f"async-delegation cap is {cap} — no slot to spare for a watcher"
+    if live >= cap - 1:
+        return False, (
+            f"async-delegation pool is near capacity ({live}/{cap}) — the last "
+            f"slot is reserved for real work"
+        )
+    return True, ""
+
+
+def spawn_wait_watcher(
+    *,
+    goal_session_id: str,
+    goal_text: str,
+    reason: str,
+    session_id: Optional[str] = None,
+    pid: Optional[int] = None,
+    until: Optional[float] = None,
+    since: Optional[float] = None,
+    existing_keys: Optional[List[str]] = None,
+    live_watchers: int = 0,
+) -> Dict[str, Any]:
+    """Dispatch a background watcher that owns this wait. Never raises.
+
+    Returns ``{"status": "dispatched", "delegation_id", "target_key"}``, or
+    ``{"status": "skipped", "reason": ...}``. Every refusal is a reason string so
+    the caller can log why a wait was not delegated instead of silently
+    pretending it was.
+    """
+    key = target_key(session_id=session_id, pid=pid, until=until)
+    if not key:
+        return {"status": "skipped", "reason": "no watchable target"}
+
+    # Bound 1 — one watcher per target. A goal re-parking on the same job every
+    # turn must not accumulate watchers.
+    if existing_keys and key in set(existing_keys):
+        return {"status": "skipped", "reason": f"already watching {key}", "target_key": key}
+
+    # Bound 2 — per-goal ceiling.
+    ceiling = max_wait_watchers()
+    if ceiling <= 0:
+        return {"status": "skipped", "reason": "wait watchers disabled (max_wait_watchers=0)",
