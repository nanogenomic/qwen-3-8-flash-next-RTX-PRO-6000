+class TestTheWatcherIsCheap:
+    """GPU0's KV pool is shared with Andre's other main session, and a prior
+    agent measured wasted prefill per call rising from 2,622 tokens with no
+    contention to 114,385 with five other in-flight requests. A watcher that
+    reasoned about its job would pay that per poll, forever, to answer a
+    boolean."""
+
+    def test_the_watcher_makes_no_model_call_at_all(self, hermes_home):
+        """The strongest possible form of 'small context': none."""
+        import agent.auxiliary_client as aux
+        from hermes_cli import goal_watchers
+
+        def _boom(**kw):
+            raise AssertionError("a watcher must never call a model")
+
+        with patch.object(aux, "call_llm", _boom):
+            result = goal_watchers.run_watch_loop(
+                session_id=None, pid=None, until=time.time() - 1, since=time.time(),
+                reason="a deadline that has already passed", goal_text="g",
+            )
+        assert result["status"] == "completed"
+        assert result["api_calls"] == 0
+        assert result["released"] is True
+
